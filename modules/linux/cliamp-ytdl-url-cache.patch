+// PeekPrev returns the previous track without moving the playlist position,
+// mirroring Prev's selection so a caller can prepare the track Prev would
+// pick. Returns false when there is no predictable previous track.
+func (p *Playlist) PeekPrev() (Track, bool) {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if len(p.tracks) == 0 {
+		return Track{}, false
+	}
+	if _, idx, ok := p.lastPlayableOrderSlot(p.pos - 1); ok {
+		return cloneTrack(p.tracks[idx]), true
+	}
+	if p.repeat == RepeatAll {
+		if _, idx, ok := p.lastPlayableOrderSlot(len(p.order) - 1); ok {
+			return cloneTrack(p.tracks[idx]), true
+		}
+	}
+	return Track{}, false
+}
+
