diff --git a/player/ytdlurlcache.go b/player/ytdlurlcache.go
new file mode 100644
index 0000000..4972433
--- /dev/null
+++ b/player/ytdlurlcache.go
@@ -0,0 +1,192 @@
+package player
+
+import (
+	"context"
+	"net/url"
+	"os/exec"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+)
+
+// ytdlURLCacheMax bounds how many resolved stream URLs are retained. Entries
+// are ~1-2 KB each, so this is a negligible amount of memory for a window far
+// larger than the few neighbours that are ever warmed.
+const ytdlURLCacheMax = 64
+
+// ytdlURLExpiryGuard is subtracted from a URL's own expiry before it is
+// considered usable. Google's videoplayback URLs carry expire= roughly six
+// hours out; refusing one that is nearly due avoids handing ffmpeg a URL that
+// dies mid-track.
+const ytdlURLExpiryGuard = 5 * time.Minute
+
+// ytdlURLDefaultTTL applies when a resolved URL carries no expiry we can parse
+// (non-YouTube extractors). Short enough that a stale entry is a rare one-off
+// fallback rather than a persistent failure.
+const ytdlURLDefaultTTL = 30 * time.Minute
+
+// ytdlResolveTimeout bounds a single background resolution.
+const ytdlResolveTimeout = 30 * time.Second
+
+type ytdlURLEntry struct {
+	directURL string
+	expires   time.Time
+}
+
+// ytdlURLCache memoises page URL -> direct media URL resolutions so that a
+// track change can hand the media URL straight to ffmpeg instead of paying for
+// a cold yt-dlp extraction (player JS fetch plus nsig decipher, seconds) on
+// every switch.
+type ytdlURLCache struct {
+	mu       sync.Mutex
+	entries  map[string]ytdlURLEntry
+	inflight map[string]struct{}
+}
+
+func newYTDLURLCache() *ytdlURLCache {
+	return &ytdlURLCache{
+		entries:  make(map[string]ytdlURLEntry),
+		inflight: make(map[string]struct{}),
+	}
+}
+
+// lookup returns a cached direct URL when one is present and not near expiry.
+func (c *ytdlURLCache) lookup(pageURL string) (string, bool) {
+	if c == nil {
+		return "", false
+	}
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	e, ok := c.entries[pageURL]
+	if !ok {
+		return "", false
+	}
+	if time.Now().After(e.expires) {
+		delete(c.entries, pageURL)
+		return "", false
+	}
+	return e.directURL, true
+}
+
+// drop removes an entry, used when ffmpeg rejects a URL we believed was fresh.
+func (c *ytdlURLCache) drop(pageURL string) {
+	if c == nil {
+		return
+	}
+	c.mu.Lock()
+	delete(c.entries, pageURL)
+	c.mu.Unlock()
+}
+
+func (c *ytdlURLCache) store(pageURL, directURL string, expires time.Time) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	// Evict arbitrarily once over the cap. Entries are interchangeable and the
+	// working set (current track plus neighbours) is far below the limit, so
+	// there is nothing to gain from tracking recency.
+	for k := range c.entries {
+		if len(c.entries) < ytdlURLCacheMax {
+			break
+		}
+		delete(c.entries, k)
+	}
+	c.entries[pageURL] = ytdlURLEntry{directURL: directURL, expires: expires}
+}
+
+// warm resolves pageURL in the background unless it is already cached or a
+// resolution is already in flight. It never blocks the caller.
+func (c *ytdlURLCache) warm(pageURL string) {
+	if c == nil || pageURL == "" {
+		return
+	}
+	if _, ok := c.lookup(pageURL); ok {
+		return
+	}
+	c.mu.Lock()
+	if _, busy := c.inflight[pageURL]; busy {
+		c.mu.Unlock()
+		return
+	}
+	c.inflight[pageURL] = struct{}{}
+	c.mu.Unlock()
+
+	go func() {
+		defer func() {
+			c.mu.Lock()
+			delete(c.inflight, pageURL)
+			c.mu.Unlock()
+		}()
+		directURL, expires, err := resolveYTDLURL(pageURL)
+		if err != nil || directURL == "" {
+			return
+		}
+		c.store(pageURL, directURL, expires)
+	}()
+}
+
+// resolveYTDLURL asks yt-dlp for the direct media URL of pageURL, using the
+// same format selector as the streaming path so the cached URL names the same
+// audio the cold path would have picked.
+func resolveYTDLURL(pageURL string) (string, time.Time, error) {
+	ctx, cancel := context.WithTimeout(context.Background(), ytdlResolveTimeout)
+	defer cancel()
+
+	args := []string{
+		"-f", ytdlFormatSelector,
+		"--no-playlist",
+		"--quiet",
+		"--no-warnings",
+		"--socket-timeout", "15",
+		"--print", "urls",
+	}
+	args = appendYTDLCookieArgs(args, pageURL)
+	// "--" stops yt-dlp parsing pageURL as a flag, matching decodeYTDLPipe.
+	args = append(args, "--", pageURL)
+
+	cmd := exec.CommandContext(ctx, "yt-dlp", args...)
+	cmd.WaitDelay = 3 * time.Second
+	out, err := cmd.Output()
+	if err != nil {
+		return "", time.Time{}, err
+	}
+
+	directURL := strings.TrimSpace(string(out))
+	if i := strings.IndexByte(directURL, '\n'); i >= 0 {
+		directURL = strings.TrimSpace(directURL[:i])
+	}
+	if !strings.HasPrefix(directURL, "http://") && !strings.HasPrefix(directURL, "https://") {
+		return "", time.Time{}, errNotDirectURL
+	}
+	// HLS needs yt-dlp's segment handling; handing a playlist to the ffmpeg
+	// fast path would change how the stream is fetched, so decline to cache it
+	// and let the cold path run.
+	if strings.Contains(directURL, ".m3u8") {
+		return "", time.Time{}, errNotDirectURL
+	}
+	return directURL, ytdlURLExpiry(directURL), nil
+}
+
+// ytdlURLExpiry reads the expire= epoch Google attaches to videoplayback URLs,
+// backing off by ytdlURLExpiryGuard. Extractors that carry no such parameter
+// fall back to a short fixed TTL.
+func ytdlURLExpiry(directURL string) time.Time {
+	fallback := time.Now().Add(ytdlURLDefaultTTL)
+	u, err := url.Parse(directURL)
+	if err != nil {
+		return fallback
+	}
+	raw := u.Query().Get("expire")
+	if raw == "" {
+		return fallback
+	}
+	secs, err := strconv.ParseInt(raw, 10, 64)
+	if err != nil {
+		return fallback
+	}
+	expiry := time.Unix(secs, 0).Add(-ytdlURLExpiryGuard)
+	if !expiry.After(time.Now()) {
+		return fallback
+	}
+	return expiry
+}
diff --git a/player/ytdlurlcache_test.go b/player/ytdlurlcache_test.go
new file mode 100644
index 0000000..2b85af1
--- /dev/null
+++ b/player/ytdlurlcache_test.go
@@ -0,0 +1,116 @@
+package player
+
+import (
+	"fmt"
+	"testing"
+	"time"
+)
+
+func TestYTDLURLCacheLookupMiss(t *testing.T) {
+	c := newYTDLURLCache()
+	if _, ok := c.lookup("https://youtu.be/abc"); ok {
+		t.Fatal("lookup() on an empty cache returned a hit")
+	}
+}
+
+func TestYTDLURLCacheStoreAndLookup(t *testing.T) {
+	c := newYTDLURLCache()
+	c.store("page", "https://direct.example/media", time.Now().Add(time.Hour))
+	got, ok := c.lookup("page")
+	if !ok {
+		t.Fatal("lookup() = miss, want hit")
+	}
+	if got != "https://direct.example/media" {
+		t.Fatalf("lookup() = %q, want the stored direct URL", got)
+	}
+}
+
+// An entry past its expiry must not be served: the URL is dead and handing it
+// to ffmpeg would fail the track instead of merely starting it slowly.
+func TestYTDLURLCacheLookupRejectsExpired(t *testing.T) {
+	c := newYTDLURLCache()
+	c.store("page", "https://direct.example/media", time.Now().Add(-time.Second))
+	if _, ok := c.lookup("page"); ok {
+		t.Fatal("lookup() served an expired entry")
+	}
+	c.mu.Lock()
+	_, present := c.entries["page"]
+	c.mu.Unlock()
+	if present {
+		t.Fatal("expired entry was not evicted on lookup")
+	}
+}
+
+func TestYTDLURLCacheDrop(t *testing.T) {
+	c := newYTDLURLCache()
+	c.store("page", "https://direct.example/media", time.Now().Add(time.Hour))
+	c.drop("page")
+	if _, ok := c.lookup("page"); ok {
+		t.Fatal("lookup() = hit after drop()")
+	}
+}
+
+func TestYTDLURLCacheEvictsAtCap(t *testing.T) {
+	c := newYTDLURLCache()
+	for i := range ytdlURLCacheMax + 10 {
+		c.store(fmt.Sprintf("page%d", i), "https://direct.example/media", time.Now().Add(time.Hour))
+	}
+	c.mu.Lock()
+	n := len(c.entries)
+	c.mu.Unlock()
+	if n > ytdlURLCacheMax {
+		t.Fatalf("cache holds %d entries, want at most %d", n, ytdlURLCacheMax)
+	}
+}
+
+// The expiry comes from the URL's own expire= parameter, backed off by the
+// guard, so a URL is retired before Google stops honouring it.
+func TestYTDLURLExpiryUsesExpireParam(t *testing.T) {
+	expire := time.Now().Add(6 * time.Hour).Unix()
+	got := ytdlURLExpiry(fmt.Sprintf("https://rr3.googlevideo.com/videoplayback?expire=%d&itag=251", expire))
+	want := time.Unix(expire, 0).Add(-ytdlURLExpiryGuard)
+	if !got.Equal(want) {
+		t.Fatalf("ytdlURLExpiry() = %v, want %v", got, want)
+	}
+}
+
+func TestYTDLURLExpiryFallsBackWithoutExpireParam(t *testing.T) {
+	before := time.Now().Add(ytdlURLDefaultTTL)
+	got := ytdlURLExpiry("https://cdn.example/media.webm")
+	if got.Before(before) || got.After(before.Add(time.Minute)) {
+		t.Fatalf("ytdlURLExpiry() = %v, want ~%v (the default TTL)", got, before)
+	}
+}
+
+// An expire= already in the past must not produce an expiry in the past, which
+// would cache an entry that can never be served.
+func TestYTDLURLExpiryIgnoresPastExpireParam(t *testing.T) {
+	past := time.Now().Add(-time.Hour).Unix()
+	got := ytdlURLExpiry(fmt.Sprintf("https://rr3.googlevideo.com/videoplayback?expire=%d", past))
+	if !got.After(time.Now()) {
+		t.Fatalf("ytdlURLExpiry() = %v, want a future fallback", got)
+	}
+}
+
+// warm must not resolve twice for a URL already cached — the whole point is to
+// spend one extraction per track, not one per neighbour scan.
+func TestYTDLURLCacheWarmSkipsCached(t *testing.T) {
+	c := newYTDLURLCache()
+	c.store("page", "https://direct.example/media", time.Now().Add(time.Hour))
+	c.warm("page")
+	c.mu.Lock()
+	_, busy := c.inflight["page"]
+	c.mu.Unlock()
+	if busy {
+		t.Fatal("warm() started a resolution for an already-cached URL")
+	}
+}
+
+func TestYTDLURLCacheNilSafe(t *testing.T) {
+	var c *ytdlURLCache
+	if _, ok := c.lookup("page"); ok {
+		t.Fatal("lookup() on a nil cache returned a hit")
+	}
+	c.warm("page")
+	c.drop("page")
+}
