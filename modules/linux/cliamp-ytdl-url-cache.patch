+// Local files do not go through yt-dlp, so warming them would spawn a
+// pointless extraction.
+func TestWarmNeighborsSkipsNonYTDLTracks(t *testing.T) {
+	pl := playlist.New()
+	pl.Add(
+		playlist.Track{Title: "Local prev", Path: "/tmp/prev.mp3", DurationSecs: 180},
+		ytTrack("Current", "bbb"),
+		playlist.Track{Title: "Local next", Path: "/tmp/next.mp3", DurationSecs: 180},
+	)
+	pl.SetIndex(1)
+	player := &playbackFakeEngine{playing: true}
+	m := Model{player: player, playlist: pl}
+	m.setPlaybackTrack(ytTrack("Current", "bbb"))
+
+	m.warmNeighbors()
+
+	if len(player.warmed) != 0 {
+		t.Fatalf("warmed = %v, want none for local files", player.warmed)
+	}
+}
