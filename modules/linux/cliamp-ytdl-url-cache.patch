+package model
+
+import (
+	"slices"
+	"testing"
+
+	"github.com/bjarneo/cliamp/playlist"
+)
+
+func ytTrack(title, id string) playlist.Track {
+	return playlist.Track{Title: title, Path: "https://music.youtube.com/watch?v=" + id, DurationSecs: 180}
+}
+
+// The point of warming is that a Next or Prev keypress finds the URL already
+// resolved, so both neighbours must be warmed as soon as a track starts —
+// not only near the end of it, as the gapless preload is.
+func TestWarmNeighborsWarmsBothDirections(t *testing.T) {
+	pl := playlist.New()
+	pl.Add(ytTrack("First", "aaa"), ytTrack("Second", "bbb"), ytTrack("Third", "ccc"))
+	pl.SetIndex(1)
+	player := &playbackFakeEngine{playing: true}
+	m := Model{player: player, playlist: pl}
+	m.setPlaybackTrack(ytTrack("Second", "bbb"))
+
+	m.warmNeighbors()
+
+	if !slices.Contains(player.warmed, "https://music.youtube.com/watch?v=ccc") {
+		t.Errorf("next track was not warmed; warmed = %v", player.warmed)
+	}
+	if !slices.Contains(player.warmed, "https://music.youtube.com/watch?v=aaa") {
+		t.Errorf("previous track was not warmed; warmed = %v", player.warmed)
+	}
+}
