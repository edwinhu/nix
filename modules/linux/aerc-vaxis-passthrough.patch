 	case vaxis.MouseLeftButton,
diff --git c/widgets/term/term.go w/widgets/term/term.go
index e37955e..3fe3493 100644
--- c/widgets/term/term.go
+++ w/widgets/term/term.go
@@ -40,6 +40,16 @@ type Model struct {
 	// protocol state through the terminal widget. Only enable this when the
 	// host terminal supports Kitty keyboard encoding.
