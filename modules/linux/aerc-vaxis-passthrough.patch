+// kittyRelayChunk is the payload size of one transmission chunk. The kitty
+// protocol caps an escape code's payload at 4096 base64 bytes.
+const kittyRelayChunk = 4096
+
+// KittyRelay is one image on the HOST terminal whose bytes were produced by
+// somebody else -- a child process of an embedded terminal, whose own kitty
+// graphics commands are forwarded here rather than decoded into pixels.
+//
+// The relay owns a host image id of its own ([Vaxis.ReserveGraphicID]) and
+// nothing else: the controls and the base64 payload are handed to it already
+// parsed, rebuilt and validated by whoever is doing the relaying. It never
+// interprets them.
+type KittyRelay struct {
+	vx *Vaxis
+	id uint64
+
+	// mu guards the fields below it. SetTransmit runs on the embedded
+	// terminal's parser goroutine and writeTo runs inside the render, so the
+	// two genuinely race.
+	mu        sync.Mutex
+	rev       uint64
+	sentRev   uint64
+	controls  string
+	destroyed bool
+	// dropped records that the body this revision was given was reclaimed
+	// before it could be written. There is nothing to transmit, so the
+	// placement writes nothing at all rather than an empty image.
+	dropped bool
+
+	// herdr is this image's layer on the herdr pane this process runs in, and
+	// sinkOwned says the layer currently HAS the image. While it does, nothing
+	// about the image reaches the tty: no transmit, no placement, no delete.
+	// Ownership begins at the first frame the sink accepts and ends when the
+	// stream dies or a medium arrives that only the tty relay can carry.
+	herdr     *herdrStream
+	sinkOwned bool
+
+	// pmu guards payload alone, so the body can be reclaimed by the budget
+	// below without taking mu. Lock order is kittyPayloads.mu, then mu, then
+	// pmu; nothing ever acquires them the other way around.
+	pmu     sync.Mutex
+	payload string
+}
+
+// kittyMaxRetainedPayloadBytes bounds the base64 bodies live relays pin at
+// once.
+//
+// A relay holds its body so a later frame can be re-transmitted, and those
+// bytes come from a CHILD process: a few images open at the protocol's own
+// per-transfer ceiling is tens of megabytes of base64 that no render will read
+// again. Past the budget the oldest retained body is reclaimed.
+const kittyMaxRetainedPayloadBytes = 8 << 20
+
+// kittyPayloads is the process-wide retained-body budget. It is global because
+// relays belong to no shared owner -- a relay is created from a *Vaxis but
+// several terminals, each with their own, must share one ceiling.
+var kittyPayloads struct {
+	mu    sync.Mutex
+	total int
+	held  []*KittyRelay // oldest retained body first
+}
+
+// storePayload replaces the retained body and keeps the running total honest.
+// The caller holds kittyPayloads.mu.
+func (r *KittyRelay) storePayload(body string) {
+	r.pmu.Lock()
+	defer r.pmu.Unlock()
+	kittyPayloads.total += len(body) - len(r.payload)
+	r.payload = body
+}
+
+// setPayload stores a body and reclaims older ones until the budget holds.
+func (r *KittyRelay) setPayload(body string) {
+	kittyPayloads.mu.Lock()
+	defer kittyPayloads.mu.Unlock()
+
+	r.storePayload(body)
+	kittyPayloads.held = dropKittyRelay(kittyPayloads.held, r)
+	if body == "" {
+		return
+	}
+	// The body just stored goes to the back, so it is the last one reclaimed.
+	kittyPayloads.held = append(kittyPayloads.held, r)
+
+	for kittyPayloads.total > kittyMaxRetainedPayloadBytes && len(kittyPayloads.held) > 1 {
+		victim := kittyPayloads.held[0]
+		kittyPayloads.held = dropKittyRelay(kittyPayloads.held, victim)
+		victim.mu.Lock()
+		if victim.sentRev != victim.rev {
+			// Reclaimed before it was ever written, so this revision can
+			// never be transmitted.
+			victim.dropped = true
+		}
+		victim.mu.Unlock()
+		victim.storePayload("")
+	}
+}
+
+func dropKittyRelay(relays []*KittyRelay, r *KittyRelay) []*KittyRelay {
+	kept := relays[:0]
+	for _, relay := range relays {
+		if relay == r {
+			continue
+		}
+		kept = append(kept, relay)
+	}
+	for i := len(kept); i < len(relays); i++ {
+		relays[i] = nil
+	}
+	return kept
+}
+
+// NewKittyRelay allocates a host image id for a relayed image. Nothing is
+// written to the terminal until the relay is given bytes with
+// [KittyRelay.SetTransmit] and placed with [KittyRelay.Place].
+func (vx *Vaxis) NewKittyRelay() *KittyRelay {
+	r := &KittyRelay{vx: vx, id: vx.ReserveGraphicID()}
+	// Inside a herdr pane the tty is the wrong road for a child's frames, so
+	// the relay is given a layer on the pane instead. Attaching one changes
+	// nothing on its own: the tty path stays in force until a frame the sink
+	// can actually stream arrives. Whether herdr will take frames at all is
+	// answered on a goroutine of its own, because this runs on the embedded
+	// terminal's parser goroutine with the widget's lock held -- see
+	// herdrSinkForProcess.
+	r.attachHerdrSink(herdrSinkForProcess())
+	return r
+}
+
+// ID is the host-side image id this relay was given.
+func (r *KittyRelay) ID() uint64 {
+	return r.id
+}
+
+// SetTransmit replaces the bytes this image is made of.
+//
+// controls is the comma-separated control string WITHOUT a=, i= or p=, which
+// the relay supplies itself; payload is the base64 body. Each call bumps the
+// revision, which is what makes the next render re-transmit rather than
+// re-place.
+func (r *KittyRelay) SetTransmit(controls, payload string) {
+	r.mu.Lock()
+	r.controls = controls
+	r.rev += 1
+	r.dropped = false
+	// Bytes arriving this way are bytes the herdr sink could not take -- inline
+	// pixels, a compressed body, a format that is not raw. The image goes back
+	// to the tty relay, so the layer has to go with it or the pane would show
+	// this frame's predecessor underneath the new one forever.
+	yield := r.sinkOwned
+	r.sinkOwned = false
+	hs := r.herdr
+	r.mu.Unlock()
+	if yield && hs != nil {
+		hs.close()
+	}
+	r.setPayload(payload)
+}
+
+// Place draws the image at win's origin, pid cells wide and rows tall, with
+// placementKeys appended verbatim to the control string (the caller's rebuilt
+// c=, r=, x=, y=, w=, h=, z= selection).
+//
+// Like [KittyImage.Draw] this only queues a placement; the bytes are written
+// during the render.
+func (r *KittyRelay) Place(win Window, pid uint32, cols, rows int, placementKeys string) {
+	col, row := win.Origin()
+	r.mu.Lock()
+	if r.sinkOwned && r.herdr != nil {
+		// The sink owns this image: the rectangle is what the next frame is
+		// placed at, and no placement is queued for the render -- a kitty
+		// escape here would hand herdr the picture a second time.
+		r.herdr.setPlacement(col, row, cols, rows)
+		r.mu.Unlock()
+		return
+	}
+	rev := r.rev
+	r.mu.Unlock()
+	p := &placement{
+		col: col,
+		row: row,
+		id:  r.id,
+		w:   cols,
+		h:   rows,
+		rev: rev,
+		writeTo: func(w io.Writer) {
+			r.writePlacement(w, pid, placementKeys)
+		},
+		deleteFn: func(w io.Writer) {
+			r.writeDelete(w, pid)
+		},
+	}
+	r.vx.graphicsNext = append(r.vx.graphicsNext, p)
+}
+
+// Destroy frees the host image. It is written outside the frame, through the
+// writer's own mutex, because the child may stop sending at any point and a
+// freed image must not wait for the next render to be released.
+func (r *KittyRelay) Destroy() {
+	r.mu.Lock()
+	if r.destroyed {
+		r.mu.Unlock()
+		return
+	}
+	r.destroyed = true
+	r.controls = ""
+	hs := r.herdr
+	sinkOwned := r.sinkOwned
+	transmitted := r.sentRev != 0
+	r.mu.Unlock()
+	r.setPayload("")
+	if hs != nil {
+		hs.close()
+	}
+	if sinkOwned && !transmitted {
+		// Every frame of this image went to the pane's layer, which close just
+		// removed. Nothing was ever transmitted to the host terminal, so there
+		// is no host image to free -- and a delete for an id the host never
+		// heard of is exactly the escape this path exists to avoid.
+		return
+	}
+	r.vx.DeleteKittyImage(r.id)
+}
+
+// writePlacement emits either a full re-transmission or a bare re-placement,
+// depending on whether the bytes have changed since they were last written.
+func (r *KittyRelay) writePlacement(w io.Writer, pid uint32, placementKeys string) {
+	r.mu.Lock()
+	switch {
+	case r.sinkOwned:
+		// The herdr sink has this image. Its frames already went to herdr over
+		// the graphics socket, and an escape here would make the pane
+		// composite the picture a second time -- the stall this path exists to
+		// avoid.
+		r.mu.Unlock()
+		return
+	case r.destroyed, r.dropped:
+		// Either the image is gone or its body was reclaimed under the
+		// retained-bytes budget; in both cases there is nothing to say.
+		r.mu.Unlock()
+		return
+	case r.sentRev == r.rev:
+		// Same bytes, so the host still holds the image: ask it to put the
+		// existing one here again. C=1 for the same reason as the transmit
+		// below.
+		_, _ = fmt.Fprintf(w, "\x1B_Ga=p,i=%d,p=%d,C=1,q=2\x1B\\", r.id, pid)
+		r.mu.Unlock()
+		return
+	}
+	r.transmitLocked(w, pid, placementKeys)
+	r.sentRev = r.rev
+	r.mu.Unlock()
+
+	// The host holds the bytes now, so this copy is dead weight. Reclaiming
+	// it here is what keeps the steady state at zero retained bytes: the
+	// budget above only has to catch bodies that were never drawn.
+	r.setPayload("")
+}
+
+func (r *KittyRelay) transmitLocked(w io.Writer, pid uint32, placementKeys string) {
+	// C=1 belongs to the relay's own key group, not the child's: the host
+	// cursor is the embedding application's, so a relayed frame must never move
+	// it however the child asked to be placed. It is written last so it also
+	// overrides a C= a caller passed in through placementKeys.
+	controls := joinKittyKeys(
+		"a=T",
+		r.controls,
+		placementKeys,
+		fmt.Sprintf("i=%d,p=%d,C=1,q=2", r.id, pid),
+	)
+	r.pmu.Lock()
+	body := r.payload
+	r.pmu.Unlock()
+	if len(body) <= kittyRelayChunk {
+		_, _ = fmt.Fprintf(w, "\x1B_G%s;%s\x1B\\", controls, body)
+		return
+	}
+	// Chunked: the first escape code carries the controls, every later one
+	// carries only m=, and m=0 marks the last.
+	first := body[:kittyRelayChunk]
+	body = body[kittyRelayChunk:]
+	_, _ = fmt.Fprintf(w, "\x1B_G%s,m=1;%s\x1B\\", controls, first)
+	for len(body) > 0 {
+		n := min(kittyRelayChunk, len(body))
+		more := 1
+		if n == len(body) {
+			more = 0
+		}
+		_, _ = fmt.Fprintf(w, "\x1B_Gm=%d,q=2;%s\x1B\\", more, body[:n])
+		body = body[n:]
+	}
+}
+
+func (r *KittyRelay) writeDelete(w io.Writer, pid uint32) {
+	r.mu.Lock()
+	destroyed := r.destroyed
+	// Sink ownership begins at the FIRST frame the sink accepts, which may be
+	// the second frame of the image: an image transmitted to the host before
+	// that (sentRev > 0) has a host copy sitting underneath everything herdr
+	// composites, and only a delete takes it off the screen. Freeing an id the
+	// host still holds is not the escape this path exists to avoid -- the ones
+	// it avoids are the transmit and the placement, which carry the picture.
+	untransmitted := r.sinkOwned && r.sentRev == 0
+	r.mu.Unlock()
+	if untransmitted {
+		// The host was never told about this image, so there is nothing there
+		// to delete.
+		return
+	}
+	if destroyed {
+		// The image itself is gone, so free its data rather than only this
+		// placement.
+		_, _ = fmt.Fprintf(w, "\x1B_Ga=d,d=I,i=%d,q=2\x1B\\", r.id)
+		return
+	}
+	_, _ = fmt.Fprintf(w, "\x1B_Ga=d,d=i,i=%d,p=%d,q=2\x1B\\", r.id, pid)
+}
+
+// joinKittyKeys concatenates control fragments with commas, skipping the empty
+// ones so an absent group cannot produce a ",," the host reads as a malformed
+// key.
+func joinKittyKeys(parts ...string) string {
+	var b strings.Builder
+	for _, part := range parts {
+		if part == "" {
+			continue
+		}
+		if b.Len() > 0 {
+			b.WriteByte(',')
+		}
+		b.WriteString(part)
+	}
+	return b.String()
+}
+
+// DeleteKittyImage frees a host-side kitty image and every placement of it.
+//
+// The write goes through the writer's mutex rather than the frame, so it is
+// safe to call from outside the render loop.
+func (vx *Vaxis) DeleteKittyImage(id uint64) {
+	vx.writeControlString(fmt.Sprintf("\x1B_Ga=d,d=I,i=%d,q=2\x1B\\", id))
+}
+
