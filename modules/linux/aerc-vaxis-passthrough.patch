+// mousePixels is the position to report for msg in SGR-pixel mouse mode
+// (DECSET 1016).
+//
+// A child that turns 1016 on is answered in PIXELS. The vaxis.Mouse an
+// embedding application delivers, though, was decoded from a HOST terminal that
+// is not itself in 1016 mode, so it carries cell coordinates and leaves
+// XPixel/YPixel at zero -- and reporting those verbatim puts every event at
+// pixel 0,0. Measured against terminal-browser, which enables 1003, 1006 and
+// 1016 in one handshake: four wheel-down events at 0;0 leave window.scrollY at
+// 0, while the same four at any in-viewport pixel move it by 240. The page
+// renders and the wheel does nothing, which reads as a hung pane rather than a
+// bug.
+//
+// So aim at the middle of the cell the event landed in, using the widget's own
+// pixel geometry, and only report the raw zeroes when no cell size is known.
+func (vt *Model) mousePixels(msg vaxis.Mouse) (int, int) {
+	if msg.XPixel != 0 || msg.YPixel != 0 {
+		return msg.XPixel, msg.YPixel
+	}
+	cellWidth, cellHeight := vt.mouseCellPixels()
+	if cellWidth <= 0 || cellHeight <= 0 {
+		return msg.XPixel, msg.YPixel
+	}
+	col, row := max(msg.Col, 0), max(msg.Row, 0)
+	return col*cellWidth + cellWidth/2 + 1, row*cellHeight + cellHeight/2 + 1
+}
+
+// mouseCellPixels is the pixel size of one cell, or 0,0 when the embedder has
+// not told this terminal how big a pixel is.
+func (vt *Model) mouseCellPixels() (int, int) {
+	if vt.size.Cols <= 0 || vt.size.Rows <= 0 {
+		return 0, 0
+	}
+	return vt.size.XPixel / vt.size.Cols, vt.size.YPixel / vt.size.Rows
+}
+
