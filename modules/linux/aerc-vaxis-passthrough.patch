diff --git c/herdr_relay.go w/herdr_relay.go
new file mode 100644
index 0000000..ed9abba
--- /dev/null
+++ w/herdr_relay.go
@@ -0,0 +1,1104 @@
+package vaxis
+
+import (
+	"bufio"
+	"bytes"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"os"
+	"path/filepath"
+	"sync"
+	"time"
+
+	"go.rockorager.dev/vaxis/log"
+)
+
+// herdrSink streams a relayed image's frames to a herdr pane over herdr's API
+// socket (pane.graphics.stream) instead of writing kitty escapes to the tty.
+// herdr composites pty kitty frames slowly and holds key repeats while it
+// does, so inside a herdr pane the socket is the only path that keeps a
+// scrolling child at its own frame rate.
+//
+// The sink itself is only the answer to "does this process sit in a herdr pane
+// that will take frames" -- the paneID, where to reach it, and how to dial. The
+// per-image state (the layer, the open stream, the writer goroutine) belongs to
+// [herdrStream], so one sink serves every relay.
+type herdrSink struct {
+	paneID string
+	socket string
+	dial   func(path string) (net.Conn, error)
+
+	// fileDir is the file_frame_directory herdr advertises when the client
+	// attached to the pane can hand a frame to its terminal as a path. That is
+	// the whole point of the socket: with a directory the terminal receives a
+	// 182-byte escape naming a file, without one herdr's client inlines every
+	// frame as megabytes of base64 and the pane stalls exactly as the tty path
+	// does. Empty means this herdr takes raw bodies on the stream instead.
+	fileDir string
+}
+
+// herdrFrame is one child frame the sink can stream: a raw pixel file the
+// child already wrote (kitty t=f), with its geometry and pixel format.
+type herdrFrame struct {
+	Path   string
+	Width  int
+	Height int
+	Format string // "rgba" (kitty f=32) or "rgb" (kitty f=24)
+}
+
+const (
+	// herdrDialTimeout and herdrRPCTimeout bound the one-shot requests
+	// (pane.graphics.info, pane.graphics.stream's opening handshake,
+	// pane.graphics.clear). A herdr that does not answer must leave the relay
+	// on the tty path rather than stalling the terminal that asked.
+	herdrDialTimeout = 500 * time.Millisecond
+	herdrRPCTimeout  = 2 * time.Second
+
+	// herdrFrameTimeout bounds one frame's write. A frame is a few tens of
+	// megabytes over a unix socket; past this herdr is not draining and the
+	// stream is treated as gone.
+	herdrFrameTimeout = 5 * time.Second
+
+	// herdrMaxDimension and herdrMaxFrameBytes bound what a CHILD may ask this
+	// process to read and forward. The geometry arrives as s= and v= on the
+	// child's escape stream, so without a ceiling a single frame names more
+	// bytes than any display could hold -- and the multiplication itself would
+	// overflow.
+	herdrMaxDimension  = 1 << 16
+	herdrMaxFrameBytes = 128 << 20
+
+	// herdrPrimaryLayer is the only layer herdr passes to its terminal as a
+	// file. A named layer is composited inline and capped at 16 MiB, which is
+	// the slow road this sink exists to leave, so a herdr that advertises a
+	// frame directory is streamed to `primary` instead.
+	herdrPrimaryLayer = "primary"
+
+	// herdrFrameAckType marks the reply that says herdr is done with a frame's
+	// file. It is the only line the stream ever sends; anything else is a
+	// refusal.
+	herdrFrameAckType = "pane_graphics_frame_ack"
+
+	// herdrFileSlots is how many frame files one layer rotates through.
+	//
+	// herdr reads a file only when its terminal gets to the frame, and says so
+	// afterwards with an ack, so the file backing an unacked revision still has
+	// a reader and must not be rewritten. Slots are what give the next frame
+	// somewhere else to go; four of them is several frame times of slack at 60
+	// fps, and each one costs a frame's worth of the advertised directory.
+	herdrFileSlots = 4
+)
+
+var errHerdrStreamGone = errors.New("herdr: graphics stream is gone")
+
+// herdrPaneFromEnv answers "does this process sit in a herdr pane that should
+// be offered frames at all" from the ENVIRONMENT alone -- no dial, no round
+// trip. It is the half of the decision a caller on the embedded terminal's
+// parser goroutine can afford to make: outside herdr, and with the escape hatch
+// set, the relay must behave exactly as it always has, and that has to be
+// settled without touching a socket.
+func herdrPaneFromEnv(env func(string) string) (pane, socket string, inPane bool) {
+	if env == nil {
+		return "", "", false
+	}
+	if env("AERC_TERM_HERDR_GRAPHICS") == "0" {
+		return "", "", false
+	}
+	pane, socket = env("HERDR_PANE_ID"), env("HERDR_SOCKET_PATH")
+	return pane, socket, pane != "" && socket != ""
+}
+
+// newHerdrSink decides whether this process sits in a herdr pane whose
+// graphics socket answers. env and dial are injected so a test can run a fake
+// herdr on a temporary unix socket.
+//
+// It DIALS, so it belongs on a goroutine of its own; see [probeHerdrSink].
+//
+// Returns (nil, nil) when HERDR_PANE_ID or HERDR_SOCKET_PATH is unset or
+// AERC_TERM_HERDR_GRAPHICS is "0"; an error when herdr does not answer
+// pane.graphics.info with pane_visible true.
+func newHerdrSink(env func(string) string, dial func(path string) (net.Conn, error)) (*herdrSink, error) {
+	pane, socket, inPane := herdrPaneFromEnv(env)
+	if !inPane || dial == nil {
+		return nil, nil
+	}
+	s := &herdrSink{paneID: pane, socket: socket, dial: dial}
+	if err := s.probe(); err != nil {
+		return nil, err
+	}
+	return s, nil
+}
+
+// herdrSinkPromise is one probe: in flight, or finished.
+//
+// The probe costs a dial and a round trip -- up to herdrDialTimeout +
+// herdrRPCTimeout -- and it is wanted on the embedded terminal's PARSER
+// goroutine, which holds the widget's lock and is what carries the child its
+// keystrokes. Waiting that long there stalls the whole pane, which is the exact
+// failure this sink exists to remove. So the answer is produced on a goroutine
+// of its own and collected by the only party that can afford to wait: a
+// stream's writer.
+//
+// Frames offered before the answer arrives WAIT IN THE MAILBOX; they are not
+// sent to the tty meanwhile. The other choice -- tty until the sink is ready --
+// would put the first frame of every image on the host terminal and then strand
+// it there, because a relay stops placing an image once the sink owns it and so
+// never tells the host to drop that first frame. What waiting costs instead is
+// that a probe which ends up failing loses the frames it held; the child's next
+// frame, a few milliseconds later, takes the tty path like every other frame
+// after it.
+type herdrSinkPromise struct {
+	done chan struct{}
+	// sink and err are written before done is closed and read only after it is
+	// closed, which is the whole of their synchronisation.
+	sink *herdrSink
+	err  error
+}
+
+var errHerdrNoPane = errors.New("herdr: not in a herdr pane")
+
+// probeHerdrSink starts the probe on its own goroutine and returns at once.
+func probeHerdrSink(env func(string) string, dial func(path string) (net.Conn, error)) *herdrSinkPromise {
+	p := &herdrSinkPromise{done: make(chan struct{})}
+	go func() {
+		defer close(p.done)
+		sink, err := newHerdrSink(env, dial)
+		switch {
+		case err != nil:
+			p.err = err
+		case sink == nil:
+			p.err = errHerdrNoPane
+		default:
+			p.sink = sink
+		}
+	}()
+	return p
+}
+
+// herdrSinkAnswered wraps a sink somebody else has already probed for, so a
+// caller holding one takes the same path the process-wide probe does.
+func herdrSinkAnswered(s *herdrSink) *herdrSinkPromise {
+	p := &herdrSinkPromise{done: make(chan struct{}), sink: s}
+	close(p.done)
+	return p
+}
+
+// refused reports a probe that HAS ALREADY answered, with an answer of no. It
+// never waits: an unanswered probe is not a refusal.
+//
+// This is what keeps the "herdr does not take frames" fallback honest. A relay
+// attached to a refused probe would still accept its first frame into the
+// mailbox and only then discover there is no sink -- and that frame is gone,
+// because the relay told the widget it owned the image and so nothing was ever
+// queued for the tty. One relay may lose one frame that way, to the probe that
+// was still in flight when it was created; every relay after the answer must
+// simply be a relay without a sink, which is byte-for-byte today's tty path.
+func (p *herdrSinkPromise) refused() bool {
+	select {
+	case <-p.done:
+		return p.err != nil
+	default:
+		return false
+	}
+}
+
+// wait blocks until the probe has answered, or until quit says the stream it
+// was for is gone.
+func (p *herdrSinkPromise) wait(quit <-chan struct{}) (*herdrSink, error) {
+	select {
+	case <-p.done:
+	case <-quit:
+		return nil, errHerdrStreamGone
+	}
+	if p.err != nil {
+		return nil, p.err
+	}
+	return p.sink, nil
+}
+
+// processHerdrSink is the one probe every relay in this process shares. Its
+// answer cannot change while the process runs, and a child that names a fresh
+// image id per frame must not buy a socket handshake per frame.
+var processHerdrSink struct {
+	once    sync.Once
+	promise *herdrSinkPromise
+}
+
+// herdrSinkForProcess returns that probe, starting it the first time it is
+// asked. It never blocks and never touches a socket on the caller's goroutine.
+// nil means this process is not in a herdr pane at all -- the one answer that
+// IS available immediately, because it is read from the environment.
+func herdrSinkForProcess() *herdrSinkPromise {
+	processHerdrSink.once.Do(func() {
+		if _, _, inPane := herdrPaneFromEnv(os.Getenv); !inPane {
+			return
+		}
+		processHerdrSink.promise = probeHerdrSink(os.Getenv, dialHerdr)
+	})
+	return processHerdrSink.promise
+}
+
+func dialHerdr(path string) (net.Conn, error) {
+	return net.DialTimeout("unix", path, herdrDialTimeout)
+}
+
+// herdrRequest is one newline-delimited JSON call on herdr's API socket.
+type herdrRequest struct {
+	ID     string         `json:"id"`
+	Method string         `json:"method"`
+	Params map[string]any `json:"params"`
+}
+
+// herdrReply is as much of herdr's answer as any caller here reads.
+type herdrReply struct {
+	Result struct {
+		Type               string `json:"type"`
+		PaneVisible        bool   `json:"pane_visible"`
+		FileFrameDirectory string `json:"file_frame_directory"`
+		Revision           uint64 `json:"revision"`
+	} `json:"result"`
+	Error json.RawMessage `json:"error"`
+}
+
+// herdrFrameHeader announces one frame. It carries the pixels one of two ways
+// and never both: file names a file herdr reads itself, and data_length says
+// exactly how many raw bytes follow this line -- herdr reads that many before
+// looking for the next header, so announcing a length the body does not match
+// desynchronises the stream for good.
+type herdrFrameHeader struct {
+	Format     string          `json:"format"`
+	Width      int             `json:"image_width"`
+	Height     int             `json:"image_height"`
+	Revision   uint64          `json:"revision"`
+	DataLength int64           `json:"data_length,omitempty"`
+	File       *herdrFrameFile `json:"file,omitempty"`
+	Placement  herdrPlacement  `json:"placement"`
+}
+
+// herdrFrameFile points at the frame instead of carrying it.
+type herdrFrameFile struct {
+	Path string `json:"path"`
+}
+
+// herdrPlacement is where the layer sits in the pane, in cells.
+type herdrPlacement struct {
+	ViewportCol int `json:"viewport_col"`
+	ViewportRow int `json:"viewport_row"`
+	GridCols    int `json:"grid_cols"`
+	GridRows    int `json:"grid_rows"`
+}
+
+// call performs a one-request connection: dial, send, read the single reply,
+// hang up. Every method but pane.graphics.stream works this way -- herdr closes
+// the connection itself once it has answered.
+func (s *herdrSink) call(id, method string, params map[string]any) (herdrReply, error) {
+	conn, err := s.dial(s.socket)
+	if err != nil {
+		return herdrReply{}, err
+	}
+	defer conn.Close()
+	_ = conn.SetDeadline(time.Now().Add(herdrRPCTimeout))
+	if err := herdrSend(conn, id, method, params); err != nil {
+		return herdrReply{}, err
+	}
+	return herdrRecv(bufio.NewReader(conn))
+}
+
+// probe asks herdr whether this pane will take frames at all, and how. It is
+// the one request the sink makes before it exists, so a herdr that does not
+// answer leaves every relay on the tty path.
+func (s *herdrSink) probe() error {
+	reply, err := s.call("info", "pane.graphics.info", map[string]any{"pane_id": s.paneID})
+	if err != nil {
+		return err
+	}
+	if !reply.Result.PaneVisible {
+		return fmt.Errorf("herdr: pane %s reports pane_visible false", s.paneID)
+	}
+	s.fileDir = usableHerdrFrameDir(reply.Result.FileFrameDirectory)
+	return nil
+}
+
+// usableHerdrFrameDir accepts an advertised frame directory only if frames can
+// actually be staged in it: an absolute path that is a directory today. A
+// relative or missing one would otherwise be discovered per frame, and every
+// frame that discovered it would be a frame the pane never showed.
+func usableHerdrFrameDir(dir string) string {
+	if dir == "" || !filepath.IsAbs(dir) {
+		return ""
+	}
+	dir = filepath.Clean(dir)
+	info, err := os.Stat(dir)
+	if err != nil || !info.IsDir() {
+		log.Debug("herdr: advertised frame directory %s is unusable, streaming raw bodies: %v", dir, err)
+		return ""
+	}
+	return dir
+}
+
+// openStream opens the one long-lived connection. It stays open and every frame
+// is written to it; herdr answers only the opening request.
+//
+// The reader that consumed the handshake is returned with the connection rather
+// than rebuilt later: it may hold buffered bytes, and a second reader over the
+// same socket would lose them.
+func (s *herdrSink) openStream(layerID string) (net.Conn, *bufio.Reader, error) {
+	conn, err := s.dial(s.socket)
+	if err != nil {
+		return nil, nil, err
+	}
+	_ = conn.SetDeadline(time.Now().Add(herdrRPCTimeout))
+	reader := bufio.NewReader(conn)
+	err = herdrSend(conn, "stream", "pane.graphics.stream", map[string]any{
+		"pane_id":  s.paneID,
+		"layer_id": layerID,
+		"z_index":  0,
+	})
+	if err == nil {
+		_, err = herdrRecv(reader)
+	}
+	if err != nil {
+		conn.Close()
+		return nil, nil, err
+	}
+	// Frames are written under their own deadline and the reply side blocks
+	// until herdr has something to say, so neither keeps the handshake's.
+	_ = conn.SetDeadline(time.Time{})
+	return conn, reader, nil
+}
+
+// clearLayer removes the layer from the pane.
+func (s *herdrSink) clearLayer(layerID string) {
+	_, err := s.call("clear", "pane.graphics.clear", map[string]any{
+		"pane_id":  s.paneID,
+		"layer_id": layerID,
+	})
+	if err != nil {
+		log.Debug("herdr: could not clear layer %s: %v", layerID, err)
+	}
+}
+
+func herdrSend(w io.Writer, id, method string, params map[string]any) error {
+	line, err := json.Marshal(herdrRequest{ID: id, Method: method, Params: params})
+	if err != nil {
+		return err
+	}
+	_, err = w.Write(append(line, '\n'))
+	return err
+}
+
+func herdrRecv(r *bufio.Reader) (herdrReply, error) {
+	line, err := r.ReadBytes('\n')
+	if err != nil {
+		return herdrReply{}, err
+	}
+	var reply herdrReply
+	if err := json.Unmarshal(line, &reply); err != nil {
+		return herdrReply{}, fmt.Errorf("herdr: unreadable reply %q", bytes.TrimSpace(line))
+	}
+	if len(reply.Error) > 0 {
+		return reply, fmt.Errorf("herdr: %s", bytes.TrimSpace(reply.Error))
+	}
+	return reply, nil
+}
+
+// herdrPlace is a layer's rectangle in pane cells.
+type herdrPlace struct {
+	col  int
+	row  int
+	cols int
+	rows int
+}
+
+// herdrStream is one image's layer on the pane: a one-slot newest-wins mailbox,
+// the goroutine that drains it onto the socket, and the rectangle the widget
+// last placed the image at.
+//
+// The mailbox is what keeps the child at its own frame rate. Writing a frame
+// costs a copy of the whole body, and the producer is the embedded terminal's
+// parser goroutine -- if it waited for that, the child would again be paced by
+// the compositor rather than by itself. So a frame that is superseded before it
+// is written is simply dropped, and the newest one always goes.
+type herdrStream struct {
+	// promise is the process's probe. The writer collects it; nobody else may
+	// wait on it.
+	promise *herdrSinkPromise
+	id      uint64
+
+	// wake carries "the state changed, look again". It is buffered so a
+	// producer never blocks and never loses a wakeup: a send that finds the
+	// slot full is dropped only because the writer has a token it has not
+	// consumed yet, and consuming it re-reads the state under mu.
+	wake chan struct{}
+	// acked carries "a frame file came free", from the goroutine reading
+	// herdr's acks to a writer waiting for somewhere to stage the next frame.
+	// Buffered and dropped the same way, for the same reason.
+	acked chan struct{}
+	quit  chan struct{}
+
+	mu sync.Mutex
+	// sink and layerID are the probe's answer, written once by the writer
+	// goroutine when it resolves the promise. They are guarded because close
+	// reads them from whatever goroutine tore the relay down.
+	sink      *herdrSink
+	layerID   string
+	started   bool
+	closed    bool
+	failed    bool
+	pending   *herdrFrame // the mailbox: the newest frame nobody has written
+	current   *herdrFrame // the frame the layer is showing
+	placed    bool
+	place     herdrPlace
+	sentPlace herdrPlace
+	revision  uint64
+	conn      net.Conn
+	// slots are the frame files this layer rotates through, and ackedRev is the
+	// highest revision herdr has finished with. A slot is free exactly when the
+	// revision last staged in it has been acked.
+	slots    []*herdrFileSlot
+	ackedRev uint64
+
+	closeOnce sync.Once
+	logOnce   sync.Once
+
+	// copyBuf is the writer goroutine's alone -- nothing else touches it, so it
+	// needs no lock. See herdrCopyBufferBytes for why it exists at all.
+	copyBuf []byte
+}
+
+// herdrCopyBufferBytes is the chunk one frame's body moves in.
+//
+// io.Copy's own default is 32 KiB, which turns a 15 MB frame into nine hundred
+// syscalls; a megabyte at a time is an order of magnitude fewer, and past that
+// the socket's send buffer -- not this one -- decides how many writes it takes.
+// A frame is never held whole, so the cost is this buffer per streaming layer.
+const herdrCopyBufferBytes = 1 << 20
+
+// herdrFileSlot is one file frames are staged in. rev is the revision the file
+// currently holds; it is free again once herdr has acked that revision.
+type herdrFileSlot struct {
+	path string
+	rev  uint64
+}
+
+// newHerdrStream is O(1): the probe it is given may not have answered yet, and
+// the layer cannot be chosen until it has. Nothing here dials, stats or waits,
+// because this runs on the embedded terminal's parser goroutine.
+func newHerdrStream(promise *herdrSinkPromise, id uint64) *herdrStream {
+	return &herdrStream{
+		promise: promise,
+		id:      id,
+		wake:    make(chan struct{}, 1),
+		acked:   make(chan struct{}, 1),
+		quit:    make(chan struct{}),
+	}
+}
+
+// offer puts a frame in the mailbox, replacing whatever was waiting there. It
+// reports false once the stream is closed or gone, which is the caller's signal
+// to go back to the tty path.
+func (s *herdrStream) offer(f herdrFrame) bool {
+	s.mu.Lock()
+	if s.closed || s.failed {
+		s.mu.Unlock()
+		return false
+	}
+	frame := f
+	s.pending = &frame
+	if !s.started {
+		s.started = true
+		go s.run()
+	}
+	s.mu.Unlock()
+	s.signal()
+	return true
+}
+
+// setPlacement records where the widget drew the image. The first frame waits
+// for this, and a later change re-sends the current frame at the new rectangle.
+func (s *herdrStream) setPlacement(col, row, cols, rows int) {
+	s.mu.Lock()
+	if s.closed {
+		s.mu.Unlock()
+		return
+	}
+	s.place = herdrPlace{col: col, row: row, cols: cols, rows: rows}
+	s.placed = true
+	s.mu.Unlock()
+	s.signal()
+}
+
+func (s *herdrStream) signal() {
+	select {
+	case s.wake <- struct{}{}:
+	default:
+	}
+}
+
+func (s *herdrStream) run() {
+	sink, layer, ok := s.resolveSink()
+	if !ok {
+		return
+	}
+	for {
+		select {
+		case <-s.wake:
+		case <-s.quit:
+			return
+		}
+		if !s.drain(sink, layer) {
+			return
+		}
+	}
+}
+
+// resolveSink collects the process's probe and settles which layer this stream
+// writes to. It is done HERE, on the writer goroutine, because the writer is
+// the only party that may wait for it: the frames offered meanwhile sit in the
+// one-slot mailbox, and the newest of them goes out the moment the answer
+// arrives.
+func (s *herdrStream) resolveSink() (*herdrSink, string, bool) {
+	sink, err := s.promise.wait(s.quit)
+	if err != nil {
+		s.fail(err)
+		return nil, "", false
+	}
+	// A herdr that takes files hands them to its terminal, and it only does
+	// that for `primary`; a layer of our own naming would be composited inline
+	// and put the pane back where it started.
+	layer := herdrPrimaryLayer
+	if sink.fileDir == "" {
+		layer = fmt.Sprintf("aerc-relay-%d", s.id)
+	}
+	s.mu.Lock()
+	live := !s.closed && !s.failed
+	if live {
+		// Published for close, which may have to clear the layer from another
+		// goroutine entirely.
+		s.sink, s.layerID = sink, layer
+	}
+	s.mu.Unlock()
+	return sink, layer, live
+}
+
+// drain writes frames until the mailbox is empty and the layer is showing the
+// current rectangle. It reports whether the stream is still usable.
+func (s *herdrStream) drain(sink *herdrSink, layer string) bool {
+	for {
+		s.mu.Lock()
+		if s.closed || s.failed {
+			s.mu.Unlock()
+			return false
+		}
+		if !s.placed {
+			// Nothing may be drawn before the widget has said where.
+			s.mu.Unlock()
+			return true
+		}
+		frame, resend := s.pending, false
+		switch {
+		case frame != nil:
+			s.pending = nil
+		case s.current != nil && s.place != s.sentPlace:
+			// The rectangle moved under the frame already on screen.
+			frame, resend = s.current, true
+		default:
+			s.mu.Unlock()
+			return true
+		}
+		s.revision += 1
+		rev, place := s.revision, s.place
+		s.mu.Unlock()
+
+		fatal, err := s.writeFrame(sink, layer, *frame, place, rev)
+
+		s.mu.Lock()
+		switch {
+		case err == nil:
+			s.current = frame
+			s.sentPlace = place
+		case fatal:
+			s.failed = true
+		case resend:
+			// The frame on screen can no longer be read, so stop trying to
+			// move it; the next frame the child sends takes over.
+			s.current = nil
+		}
+		s.mu.Unlock()
+
+		if err != nil {
+			s.logOnce.Do(func() {
+				log.Warn("herdr: frame not streamed to layer %s: %v", layer, err)
+			})
+			if fatal {
+				s.dropConn()
+				return false
+			}
+		}
+	}
+}
+
+// writeFrame announces one frame and copies its body onto the socket.
+//
+// fatal distinguishes "this frame is no good" -- a source that cannot be read,
+// a geometry no image has -- from "the stream is gone". Only the second gives
+// the image back to the tty path; the first drops a frame the child will
+// replace anyway.
+func (s *herdrStream) writeFrame(sink *herdrSink, layer string, f herdrFrame, place herdrPlace, rev uint64) (fatal bool, err error) {
+	bpp, ok := herdrBytesPerPixel(f.Format)
+	if !ok {
+		return false, fmt.Errorf("herdr: frame format %q is not raw pixels", f.Format)
+	}
+	if f.Width <= 0 || f.Height <= 0 || f.Width > herdrMaxDimension || f.Height > herdrMaxDimension {
+		return false, fmt.Errorf("herdr: frame geometry %dx%d is out of range", f.Width, f.Height)
+	}
+	n := int64(f.Width) * int64(f.Height) * int64(bpp)
+	if n > herdrMaxFrameBytes {
+		return false, fmt.Errorf("herdr: frame of %d bytes exceeds the %d byte ceiling", n, int64(herdrMaxFrameBytes))
+	}
+	if sink.fileDir != "" {
+		return s.writeFileFrame(sink, layer, f, place, rev, n)
+	}
+	return s.writeBodyFrame(sink, layer, f, place, rev, n)
+}
+
+// writeFileFrame stages the frame in one of this layer's files and names it in
+// the header. herdr reads the file itself, so this puts a path on the socket
+// where the body path puts megabytes -- which is the whole reason the pane
+// keeps up with the child.
+func (s *herdrStream) writeFileFrame(sink *herdrSink, layer string, f herdrFrame, place herdrPlace, rev uint64, n int64) (fatal bool, err error) {
+	slot, err := s.takeFileSlot(sink.fileDir)
+	if err != nil {
+		return true, err
+	}
+	// Everything that can fail without the file being on the wire happens before
+	// the slot is claimed, so a dropped frame gives its file straight back.
+	header, err := json.Marshal(herdrFrameHeader{
+		Format:    f.Format,
+		Width:     f.Width,
+		Height:    f.Height,
+		Revision:  rev,
+		File:      &herdrFrameFile{Path: slot.path},
+		Placement: herdrPlacementOf(place),
+	})
+	if err != nil {
+		return false, err
+	}
+	if err := s.stageFrameFile(slot.path, f.Path, n); err != nil {
+		return false, err
+	}
+	// Claimed before the header goes out, so an ack for an older revision
+	// arriving mid-write cannot hand this file to the next frame.
+	s.mu.Lock()
+	slot.rev = rev
+	s.mu.Unlock()
+
+	conn, err := s.stream(sink, layer)
+	if err == nil {
+		_ = conn.SetWriteDeadline(time.Now().Add(herdrFrameTimeout))
+		_, err = conn.Write(append(header, '\n'))
+	}
+	if err != nil {
+		// herdr never got a header naming this file, and close may already have
+		// swept the ring, so nothing else will ever take it away.
+		_ = os.Remove(slot.path)
+		return true, err
+	}
+	return false, nil
+}
+
+// writeBodyFrame announces one frame and copies its body onto the socket. It is
+// what a herdr that advertised no frame directory takes.
+func (s *herdrStream) writeBodyFrame(sink *herdrSink, layer string, f herdrFrame, place herdrPlace, rev uint64, n int64) (fatal bool, err error) {
+	file, err := os.Open(f.Path)
+	if err != nil {
+		return false, err
+	}
+	defer file.Close()
+	info, err := file.Stat()
+	if err != nil {
+		return false, err
+	}
+	if !info.Mode().IsRegular() {
+		return false, fmt.Errorf("herdr: %s is not a regular file", f.Path)
+	}
+	if info.Size() < n {
+		// The header promises exactly n bytes and herdr reads that many
+		// before it looks for another header, so a source too short to
+		// deliver them is refused BEFORE the length is announced.
+		return false, fmt.Errorf("herdr: %s holds %d bytes, the frame needs %d", f.Path, info.Size(), n)
+	}
+
+	header, err := json.Marshal(herdrFrameHeader{
+		Format:     f.Format,
+		Width:      f.Width,
+		Height:     f.Height,
+		Revision:   rev,
+		DataLength: n,
+		Placement:  herdrPlacementOf(place),
+	})
+	if err != nil {
+		return false, err
+	}
+
+	conn, err := s.stream(sink, layer)
+	if err != nil {
+		return true, err
+	}
+	_ = conn.SetWriteDeadline(time.Now().Add(herdrFrameTimeout))
+	if _, err := conn.Write(append(header, '\n')); err != nil {
+		return true, err
+	}
+	// LimitReader rather than the file's own length: the body must be exactly
+	// what the header promised, whatever the file grew to since the stat.
+	written, err := io.CopyBuffer(conn, io.LimitReader(file, n), s.copyBuffer())
+	if err != nil {
+		return true, err
+	}
+	if written != n {
+		// The source shrank between the stat and the copy, so herdr is now
+		// waiting for bytes that will never arrive.
+		return true, fmt.Errorf("herdr: frame body short by %d bytes", n-written)
+	}
+	return false, nil
+}
+
+func herdrPlacementOf(place herdrPlace) herdrPlacement {
+	return herdrPlacement{
+		ViewportCol: place.col,
+		ViewportRow: place.row,
+		GridCols:    place.cols,
+		GridRows:    place.rows,
+	}
+}
+
+func (s *herdrStream) copyBuffer() []byte {
+	if s.copyBuf == nil {
+		s.copyBuf = make([]byte, herdrCopyBufferBytes)
+	}
+	return s.copyBuf
+}
+
+// takeFileSlot picks the file the next frame may be staged in: one whose
+// revision herdr has acked, or a fresh one while the ring has room. When every
+// file still has a reader it waits for an ack rather than overwriting one --
+// herdr's terminal would otherwise read a frame half replaced by its successor.
+//
+// Only the writer goroutine calls it, so the slot it returns cannot be taken
+// twice.
+func (s *herdrStream) takeFileSlot(dir string) (*herdrFileSlot, error) {
+	// Built only if the ring is actually full: the steady state finds a free
+	// file on the first look, and a timer per frame at 60 fps is pure garbage.
+	var deadline *time.Timer
+	for {
+		s.mu.Lock()
+		if s.closed || s.failed {
+			s.mu.Unlock()
+			return nil, errHerdrStreamGone
+		}
+		for _, slot := range s.slots {
+			if slot.rev <= s.ackedRev {
+				s.mu.Unlock()
+				return slot, nil
+			}
+		}
+		if len(s.slots) < herdrFileSlots {
+			// The name is this process's and this layer's alone, so two relays
+			// -- or two aercs in two panes -- never stage into one file.
+			slot := &herdrFileSlot{path: filepath.Join(dir,
+				fmt.Sprintf("aerc-relay-%d-%d-%d.raw", os.Getpid(), s.id, len(s.slots)))}
+			s.slots = append(s.slots, slot)
+			s.mu.Unlock()
+			return slot, nil
+		}
+		s.mu.Unlock()
+
+		if deadline == nil {
+			deadline = time.NewTimer(herdrFrameTimeout)
+			defer deadline.Stop()
+		}
+		select {
+		case <-s.acked:
+		case <-s.quit:
+			return nil, errHerdrStreamGone
+		case <-deadline.C:
+			return nil, fmt.Errorf("herdr: no frame file acked within %s", herdrFrameTimeout)
+		}
+	}
+}
+
+// stageFrameFile copies exactly n bytes of the child's frame into dst.
+//
+// The copy is what satisfies herdr's contract -- a regular file of this
+// process's own uid, mode 0600, a single link, exactly n bytes long -- and none
+// of that is true of the child's file, which the child rewrites for its next
+// frame while herdr's terminal is still reading this one. dst is unlinked
+// first so a reader herdr still has keeps the old inode and the new file starts
+// empty with one link.
+func (s *herdrStream) stageFrameFile(dst, src string, n int64) error {
+	in, err := os.Open(src)
+	if err != nil {
+		return err
+	}
+	defer in.Close()
+	info, err := in.Stat()
+	if err != nil {
+		return err
+	}
+	if !info.Mode().IsRegular() {
+		return fmt.Errorf("herdr: %s is not a regular file", src)
+	}
+	if info.Size() < n {
+		return fmt.Errorf("herdr: %s holds %d bytes, the frame needs %d", src, info.Size(), n)
+	}
+
+	if err := os.Remove(dst); err != nil && !errors.Is(err, os.ErrNotExist) {
+		return err
+	}
+	out, err := os.OpenFile(dst, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0o600)
+	if err != nil {
+		return err
+	}
+	// O_EXCL's mode is masked by the umask, and herdr checks the mode itself.
+	err = out.Chmod(0o600)
+	var written int64
+	if err == nil {
+		// LimitReader for the same reason the body path uses one: the file must
+		// be exactly n bytes however much the child's has grown.
+		written, err = io.CopyBuffer(out, io.LimitReader(in, n), s.copyBuffer())
+	}
+	if cerr := out.Close(); err == nil {
+		err = cerr
+	}
+	if err == nil && written != n {
+		err = fmt.Errorf("herdr: %s gave %d of the frame's %d bytes", src, written, n)
+	}
+	if err != nil {
+		_ = os.Remove(dst)
+		return err
+	}
+	return nil
+}
+
+func herdrBytesPerPixel(format string) (int, bool) {
+	switch format {
+	case "rgba":
+		return 4, true
+	case "rgb":
+		return 3, true
+	default:
+		return 0, false
+	}
+}
+
+// stream returns the open stream connection, opening it on first use. Only the
+// writer goroutine calls it.
+func (s *herdrStream) stream(sink *herdrSink, layer string) (net.Conn, error) {
+	s.mu.Lock()
+	switch {
+	case s.closed, s.failed:
+		s.mu.Unlock()
+		return nil, errHerdrStreamGone
+	case s.conn != nil:
+		conn := s.conn
+		s.mu.Unlock()
+		return conn, nil
+	}
+	s.mu.Unlock()
+
+	conn, reader, err := sink.openStream(layer)
+	if err != nil {
+		return nil, err
+	}
+
+	s.mu.Lock()
+	if s.closed || s.failed {
+		// Closed while the handshake was in flight. close saw no connection, so
+		// the layer this just opened is ours to remove as well as the socket.
+		s.mu.Unlock()
+		conn.Close()
+		sink.clearLayer(layer)
+		return nil, errHerdrStreamGone
+	}
+	s.conn = conn
+	s.mu.Unlock()
+
+	go s.watch(reader)
+	return conn, nil
+}
+
+// watch turns herdr's end of the stream into either a freed frame file or a
+// verdict. A frame acked is herdr saying it has finished reading that
+// revision's file, which is the only thing that lets the file be written again;
+// any other line is a refusal, and EOF is the pane going away. Either of those
+// puts later frames back on the tty path.
+func (s *herdrStream) watch(reader *bufio.Reader) {
+	for {
+		line, err := reader.ReadBytes('\n')
+		if err != nil {
+			s.fail(fmt.Errorf("herdr: stream ended: %w", err))
+			return
+		}
+		var reply herdrReply
+		if err := json.Unmarshal(line, &reply); err != nil {
+			s.fail(fmt.Errorf("herdr: unreadable stream reply %q", bytes.TrimSpace(line)))
+			return
+		}
+		if len(reply.Error) > 0 || reply.Result.Type != herdrFrameAckType {
+			s.fail(fmt.Errorf("herdr: stream refused a frame: %s", bytes.TrimSpace(line)))
+			return
+		}
+		s.recordAck(reply.Result.Revision)
+	}
+}
+
+// recordAck frees every frame file holding a revision herdr is done with. The
+// highest revision is kept rather than the exact one, so an ack herdr coalesces
+// or drops cannot pin a file for the rest of the stream.
+func (s *herdrStream) recordAck(rev uint64) {
+	s.mu.Lock()
+	if rev > s.ackedRev {
+		s.ackedRev = rev
+	}
+	s.mu.Unlock()
+	select {
+	case s.acked <- struct{}{}:
+	default:
+	}
+}
+
+func (s *herdrStream) fail(err error) {
+	s.mu.Lock()
+	if s.closed || s.failed {
+		// A close of our own doing, or a verdict already recorded.
+		s.mu.Unlock()
+		return
+	}
+	s.failed = true
+	s.mu.Unlock()
+	// By relay id, not by layer: a probe that never answered has no layer yet,
+	// and that is one of the ways to get here.
+	s.logOnce.Do(func() { log.Warn("herdr: relay %d back on the tty path: %v", s.id, err) })
+	s.dropConn()
+	s.signal()
+}
+
+// dropConn closes the stream connection. The writer may be blocked in a copy on
+// it; closing is what unblocks that, which is why nothing here waits for the
+// writer to finish.
+func (s *herdrStream) dropConn() {
+	s.mu.Lock()
+	conn := s.conn
+	s.conn = nil
+	s.mu.Unlock()
+	if conn != nil {
+		conn.Close()
+	}
+}
+
+// close removes the layer from the pane and shuts the writer down. It is safe
+// to call more than once, and never blocks on a write in flight.
+func (s *herdrStream) close() {
+	s.closeOnce.Do(func() {
+		s.mu.Lock()
+		s.closed = true
+		// nil while the probe has not answered -- and then no layer was ever
+		// opened and no file ever staged, so there is nothing to undo.
+		sink, layer := s.sink, s.layerID
+		opened := s.conn != nil
+		staged := make([]string, 0, len(s.slots))
+		for _, slot := range s.slots {
+			staged = append(staged, slot.path)
+		}
+		s.slots = nil
+		s.mu.Unlock()
+
+		close(s.quit)
+		s.dropConn()
+		if sink != nil && (opened || len(staged) > 0) {
+			// One short-lived connection of its own, because close runs on
+			// the caller's goroutine -- the parser, or the terminal being
+			// torn down -- and neither may wait on herdr.
+			go func() {
+				if opened {
+					sink.clearLayer(layer)
+				}
+				// Only now: while the layer stood, herdr's terminal could
+				// still be reading the frame it is showing.
+				for _, path := range staged {
+					_ = os.Remove(path)
+				}
+			}()
+		}
+	})
+}
+
+// attachHerdr gives this relay a sink that has already been probed for. A relay
+// with a sink writes nothing for its image to the tty: frames go to the socket,
+// placements are remembered for the next frame, and Destroy clears the herdr
+// layer.
+func (r *KittyRelay) attachHerdr(s *herdrSink) {
+	if s == nil {
+		return
+	}
+	r.attachHerdrSink(herdrSinkAnswered(s))
+}
+
+// attachHerdrSink gives this relay the process's probe, answered or not.
+//
+// It is O(1) and touches no socket: it runs on the embedded terminal's parser
+// goroutine with the widget's lock held, where anything slower holds up every
+// key the child has pending. The waiting is the writer goroutine's job.
+func (r *KittyRelay) attachHerdrSink(p *herdrSinkPromise) {
+	if p == nil || p.refused() {
+		// No pane, or a pane that has already said it will not take frames.
+		// Either way this relay gets no sink at all, which is what makes the
+		// fallback exactly the tty relay rather than a sink that swallows a
+		// frame per image before admitting it is dead.
+		return
+	}
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if r.herdr == nil && !r.destroyed {
+		r.herdr = newHerdrStream(p, r.id)
+	}
+}
+
+// SetTransmitFile hands the sink a frame the child wrote to a file. It
+// returns false when this relay has no sink, in which case the caller falls
+// back to SetTransmit and the tty path exactly as before.
+func (r *KittyRelay) SetTransmitFile(f herdrFrame) bool {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if r.herdr == nil || r.destroyed {
+		return false
+	}
+	// Lock order is r.mu then the stream's; the stream never reaches back for
+	// r.mu, and offer only fills a slot and wakes the writer.
+	if !r.herdr.offer(f) {
+		// The stream is gone. The image goes back to the tty relay, which the
+		// caller reaches by transmitting through SetTransmit as before.
+		r.sinkOwned = false
+		return false
+	}
+	r.sinkOwned = true
+	return true
+}
+
+// SetTransmitFrameFile hands the relay a raw pixel frame the child staged in a
+// file, and reports whether the herdr sink took it; false means the caller must
+// fall back to [KittyRelay.SetTransmit] and the tty path.
+//
+// width and height are the frame's PIXEL geometry and format is "rgba" (kitty
+// f=32) or "rgb" (f=24). path is opened and read here, so it must already have
+// passed the caller's own file-media gate.
+func (r *KittyRelay) SetTransmitFrameFile(path string, width, height int, format string) bool {
+	return r.SetTransmitFile(herdrFrame{
+		Path:   path,
+		Width:  width,
+		Height: height,
+		Format: format,
+	})
+}
