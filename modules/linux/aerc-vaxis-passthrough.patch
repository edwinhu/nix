diff --git c/kitty_relay_cursor_test.go w/kitty_relay_cursor_test.go
new file mode 100644
index 0000000..0534ed2
--- /dev/null
+++ w/kitty_relay_cursor_test.go
@@ -0,0 +1,71 @@
+package vaxis
+
+import (
+	"bytes"
+	"strings"
+	"testing"
+)
+
+// The host cursor belongs to the application embedding the terminal, never to
+// the child whose frame is being relayed. Every placement the relay writes to
+// the host therefore carries C=1 (kitty cursor-movement policy: leave the
+// cursor where it is), whatever the child asked for. Measured 2026-09-13
+// without it: ghostty moved its cursor past a 2016x1872 px frame on every
+// relayed a=T, scrolled the host screen each time, and stalled key repeat for
+// ~2.5 s -- 7 fps under aerc against 33 fps for the same child standalone.
+//
+// RED before the fix, on these assertions:
+//   TestKittyCursorPolicyOnTransmit:      a=T control string carries no C=1
+//   TestKittyCursorPolicyOnReplace:       bare a=p re-place carries no C=1
+//   TestKittyCursorPolicyIgnoresChildKeys: placement keys without C still
+//                                          reach the host without C=1
+
+// A revision the host has not seen yet is written as a full a=T transmit.
+func TestKittyCursorPolicyOnTransmit(t *testing.T) {
+	r := &KittyRelay{id: 9, rev: 2, sentRev: 1, controls: "f=32,s=4,v=4,t=d", payload: "AAAA"}
+	var out bytes.Buffer
+	r.writePlacement(&out, 5, "c=10,r=5")
+
+	got := out.String()
+	if !strings.Contains(got, "a=T") {
+		t.Fatalf("expected a full a=T transmit for an unsent revision, got %q", got)
+	}
+	if !strings.Contains(got, "C=1") {
+		t.Fatalf("relayed a=T must carry C=1 so the host cursor stays put, got %q", got)
+	}
+}
+
+// A revision the host already holds is re-placed with a bare a=p.
+func TestKittyCursorPolicyOnReplace(t *testing.T) {
+	r := &KittyRelay{id: 9, rev: 3, sentRev: 3}
+	var out bytes.Buffer
+	r.writePlacement(&out, 5, "c=10,r=5")
+
+	got := out.String()
+	if !strings.Contains(got, "a=p") {
+		t.Fatalf("expected a bare a=p re-place for a sent revision, got %q", got)
+	}
+	if !strings.Contains(got, "C=1") {
+		t.Fatalf("relayed a=p must carry C=1 so the host cursor stays put, got %q", got)
+	}
+}
+
+// The policy is the host's, not the child's: placement keys rebuilt from a
+// child frame that never named C= still produce C=1 on the host, on both paths.
+func TestKittyCursorPolicyIgnoresChildKeys(t *testing.T) {
+	for _, tc := range []struct {
+		name string
+		r    *KittyRelay
+	}{
+		{"transmit", &KittyRelay{id: 11, rev: 1, sentRev: 0, controls: "f=32,s=4,v=4,t=f", payload: "L3RtcC9m"}},
+		{"replace", &KittyRelay{id: 11, rev: 1, sentRev: 1}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			var out bytes.Buffer
+			tc.r.writePlacement(&out, 7, "")
+			if got := out.String(); !strings.Contains(got, "C=1") {
+				t.Fatalf("host placement without C=1 for a child that named no C=: %q", got)
+			}
+		})
+	}
+}
diff --git c/kitty_relay_herdr_test.go w/kitty_relay_herdr_test.go
new file mode 100644
index 0000000..b3d2837
--- /dev/null
+++ w/kitty_relay_herdr_test.go
@@ -0,0 +1,470 @@
+package vaxis
+
+import (
+	"bufio"
+	"bytes"
+	"encoding/json"
+	"io"
+	"net"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"sync"
+	"syscall"
+	"testing"
+	"time"
+)
+
+// Inside a herdr pane the relay must stream the child's frames to herdr's
+// graphics socket and write nothing for that image to the tty. The wire was
+// verified against herdr 0.9.0 on 2026-09-13: newline-delimited JSON on the
+// socket; pane.graphics.info answers once and closes; pane.graphics.stream
+// keeps its connection and takes frames as one header line followed by
+// exactly data_length raw bytes; herdr says nothing per frame;
+// pane.graphics.clear with the layer id removes the layer.
+//
+// RED before the implementation, on these assertions:
+//   TestKittyHerdrSinkDetectsPane:      newHerdrSink returns nil in a herdr env
+//   TestKittyHerdrStreamsFrameNotTty:   no header reaches the fake herdr; the
+//                                       tty writer still gets the a=T escape
+//   TestKittyHerdrSecondFrameBumpsRevision, TestKittyHerdrDestroyClearsLayer
+//   TestKittyHerdrOutsideHerdrIsUnchanged passes before and after (guard).
+
+type fakeHerdr struct {
+	mu         sync.Mutex
+	infos      int
+	streams    []map[string]any // stream open params
+	frames     []fakeHerdrFrame
+	clears     []map[string]any
+	visible    bool
+	fileDir    string // advertised file_frame_directory ("" = no direct transport, raw bodies only)
+	autoAck    bool   // ack every file frame as soon as it is read
+	streamConn net.Conn
+	frameCh    chan fakeHerdrFrame
+	clearCh    chan map[string]any
+	listener   net.Listener
+}
+
+type fakeHerdrFrame struct {
+	header map[string]any
+	body   []byte
+	path   string // the file the header named, if any
+}
+
+// ack answers one file frame the way herdr does once the terminal took it.
+func (f *fakeHerdr) ack(t *testing.T, revision int) {
+	t.Helper()
+	f.mu.Lock()
+	c := f.streamConn
+	f.mu.Unlock()
+	if c == nil {
+		t.Fatalf("no stream connection to ack on")
+	}
+	_, _ = c.Write([]byte(`{"id":"stream:file:0","result":{"type":"pane_graphics_frame_ack","sequence":0,"revision":` + strconv.Itoa(revision) + `}}` + "\n"))
+}
+
+// newFakeHerdrDirect advertises a frame directory the way a direct-graphics-capable herdr does.
+func newFakeHerdrDirect(t *testing.T, autoAck bool) *fakeHerdr {
+	t.Helper()
+	f := newFakeHerdr(t, true)
+	f.fileDir = filepath.Join(t.TempDir(), "source")
+	if err := os.MkdirAll(f.fileDir, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	f.autoAck = autoAck
+	return f
+}
+
+func newFakeHerdr(t *testing.T, visible bool) *fakeHerdr {
+	t.Helper()
+	dir := t.TempDir()
+	sock := filepath.Join(dir, "herdr.sock")
+	l, err := net.Listen("unix", sock)
+	if err != nil {
+		t.Fatalf("listen: %v", err)
+	}
+	f := &fakeHerdr{visible: visible, listener: l, frameCh: make(chan fakeHerdrFrame, 16), clearCh: make(chan map[string]any, 4)}
+	t.Cleanup(func() { _ = l.Close() })
+	go func() {
+		for {
+			c, err := l.Accept()
+			if err != nil {
+				return
+			}
+			go f.serve(c)
+		}
+	}()
+	return f
+}
+
+func (f *fakeHerdr) path() string { return f.listener.Addr().String() }
+
+func (f *fakeHerdr) serve(c net.Conn) {
+	defer c.Close()
+	r := bufio.NewReader(c)
+	line, err := r.ReadBytes('\n')
+	if err != nil {
+		return
+	}
+	var req struct {
+		ID     string         `json:"id"`
+		Method string         `json:"method"`
+		Params map[string]any `json:"params"`
+	}
+	if err := json.Unmarshal(line, &req); err != nil {
+		return
+	}
+	switch req.Method {
+	case "pane.graphics.info":
+		f.mu.Lock()
+		f.infos++
+		f.mu.Unlock()
+		direct := ""
+		if f.fileDir != "" {
+			direct = `,"file_frame_directory":"` + f.fileDir + `","file_frame_formats":["rgba","bgra"],"file_frame_max_bytes":16777216,"file_frame_direct_max_bytes":419430400,"file_frame_transport":"direct-kitty"`
+		}
+		_, _ = c.Write([]byte(`{"id":"` + req.ID + `","result":{"type":"pane_graphics_info","cell_width_px":16,"cell_height_px":36,"pane_visible":` + map[bool]string{true: "true", false: "false"}[f.visible] + `,"file_frame_damage":true,"max_layers_per_pane":16,"pixel_mouse":true` + direct + `}}` + "\n"))
+		return // herdr closes after one request
+	case "pane.graphics.clear":
+		f.mu.Lock()
+		f.clears = append(f.clears, req.Params)
+		f.mu.Unlock()
+		f.clearCh <- req.Params
+		_, _ = c.Write([]byte(`{"id":"` + req.ID + `","result":{"type":"ok"}}` + "\n"))
+		return
+	case "pane.graphics.stream":
+		f.mu.Lock()
+		f.streams = append(f.streams, req.Params)
+		f.streamConn = c
+		f.mu.Unlock()
+		_, _ = c.Write([]byte(`{"id":"` + req.ID + `","result":{"type":"ok"}}` + "\n"))
+		for {
+			hdrLine, err := r.ReadBytes('\n')
+			if err != nil {
+				return
+			}
+			var hdr map[string]any
+			if err := json.Unmarshal(hdrLine, &hdr); err != nil {
+				_, _ = c.Write([]byte(`{"id":"stream","error":{"code":"invalid_frame","message":"bad header"}}` + "\n"))
+				return
+			}
+			fr := fakeHerdrFrame{header: hdr}
+			if file, ok := hdr["file"].(map[string]any); ok {
+				// herdr's contract: a direct child of the advertised directory, same uid, 0600,
+				// one link, exactly width*height*bpp bytes. Anything else is rejected and the
+				// stream closed, so the fake refuses the same way.
+				p, _ := file["path"].(string)
+				fr.path = p
+				st, statErr := os.Lstat(p)
+				if statErr != nil || filepath.Dir(p) != f.fileDir || st.Mode().Perm() != 0o600 || !st.Mode().IsRegular() {
+					_, _ = c.Write([]byte(`{"id":"stream:file:0","error":{"code":"invalid_frame_file","message":"frame must be same-uid regular 0600 single-link exact-length file"}}` + "\n"))
+					return
+				}
+				fr.body, _ = os.ReadFile(p)
+				if f.autoAck {
+					rev, _ := hdr["revision"].(float64)
+					_, _ = c.Write([]byte(`{"id":"stream:file:0","result":{"type":"pane_graphics_frame_ack","sequence":0,"revision":` + strconv.Itoa(int(rev)) + `}}` + "\n"))
+				}
+			} else {
+				n, _ := hdr["data_length"].(float64)
+				fr.body = make([]byte, int(n))
+				if _, err := io.ReadFull(r, fr.body); err != nil {
+					return
+				}
+			}
+			f.mu.Lock()
+			f.frames = append(f.frames, fr)
+			f.mu.Unlock()
+			f.frameCh <- fr
+		}
+	}
+}
+
+func herdrEnv(f *fakeHerdr) func(string) string {
+	return func(k string) string {
+		switch k {
+		case "HERDR_PANE_ID":
+			return "wDE:p7"
+		case "HERDR_SOCKET_PATH":
+			return f.path()
+		}
+		return ""
+	}
+}
+
+func unixDial(path string) (net.Conn, error) { return net.Dial("unix", path) }
+
+func writeFrameFile(t *testing.T, w, h int, fill byte) string {
+	t.Helper()
+	p := filepath.Join(t.TempDir(), "frame.rgba")
+	if err := os.WriteFile(p, bytes.Repeat([]byte{fill, 2, 3, 255}, w*h), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	return p
+}
+
+func waitFrame(t *testing.T, f *fakeHerdr) fakeHerdrFrame {
+	t.Helper()
+	select {
+	case fr := <-f.frameCh:
+		return fr
+	case <-time.After(3 * time.Second):
+		t.Fatalf("no frame reached the fake herdr within 3s")
+		return fakeHerdrFrame{}
+	}
+}
+
+func TestKittyHerdrSinkDetectsPane(t *testing.T) {
+	f := newFakeHerdr(t, true)
+	s, err := newHerdrSink(herdrEnv(f), unixDial)
+	if err != nil {
+		t.Fatalf("newHerdrSink: %v", err)
+	}
+	if s == nil {
+		t.Fatalf("newHerdrSink returned no sink although HERDR_PANE_ID and HERDR_SOCKET_PATH are set and herdr answered pane.graphics.info")
+	}
+	f.mu.Lock()
+	infos := f.infos
+	f.mu.Unlock()
+	if infos != 1 {
+		t.Fatalf("pane.graphics.info requests = %d, want 1", infos)
+	}
+}
+
+func TestKittyHerdrStreamsFrameNotTty(t *testing.T) {
+	f := newFakeHerdr(t, true)
+	s, _ := newHerdrSink(herdrEnv(f), unixDial)
+	r := &KittyRelay{id: 9}
+	r.attachHerdr(s)
+
+	const w, h = 64, 32
+	path := writeFrameFile(t, w, h, 7)
+	if !r.SetTransmitFile(herdrFrame{Path: path, Width: w, Height: h, Format: "rgba"}) {
+		t.Fatalf("SetTransmitFile returned false: the relay did not take the frame for the herdr sink")
+	}
+	// The widget places the image at column 0, row 2, 40x20 cells; the first frame waits for it.
+	r.Place(Window{Column: 0, Row: 2, Width: 40, Height: 20}, 1, 40, 20, "c=40,r=20")
+	fr := waitFrame(t, f)
+
+	if got := fr.header["format"]; got != "rgba" {
+		t.Fatalf("header format = %v, want rgba", got)
+	}
+	if fr.header["image_width"] != float64(w) || fr.header["image_height"] != float64(h) {
+		t.Fatalf("header geometry = %vx%v, want %dx%d", fr.header["image_width"], fr.header["image_height"], w, h)
+	}
+	if fr.header["data_length"] != float64(w*h*4) || len(fr.body) != w*h*4 {
+		t.Fatalf("data_length = %v, body = %d bytes, want %d", fr.header["data_length"], len(fr.body), w*h*4)
+	}
+	want, _ := os.ReadFile(path)
+	if !bytes.Equal(fr.body, want) {
+		t.Fatalf("body differs from the frame file")
+	}
+	pl, _ := fr.header["placement"].(map[string]any)
+	if pl["viewport_col"] != float64(0) || pl["viewport_row"] != float64(2) || pl["grid_cols"] != float64(40) || pl["grid_rows"] != float64(20) {
+		t.Fatalf("placement = %v, want viewport 0,2 grid 40x20 (the widget's Place)", pl)
+	}
+	if rev, _ := fr.header["revision"].(float64); rev < 1 {
+		t.Fatalf("revision = %v, want >= 1", fr.header["revision"])
+	}
+	f.mu.Lock()
+	layer, _ := f.streams[0]["layer_id"].(string)
+	f.mu.Unlock()
+	if !strings.HasPrefix(layer, "aerc-relay-") {
+		t.Fatalf("stream layer_id = %q, want an aerc-relay-<id> layer", layer)
+	}
+
+	// Nothing for this image reaches the tty: neither a transmit nor a bare re-place.
+	var tty bytes.Buffer
+	r.writePlacement(&tty, 1, "c=40,r=20")
+	if tty.Len() != 0 {
+		t.Fatalf("sink-owned image wrote %q to the tty; herdr would composite it and stall", tty.String())
+	}
+}
+
+func TestKittyHerdrSecondFrameBumpsRevision(t *testing.T) {
+	f := newFakeHerdr(t, true)
+	s, _ := newHerdrSink(herdrEnv(f), unixDial)
+	r := &KittyRelay{id: 10}
+	r.attachHerdr(s)
+	const w, h = 8, 4
+	if !r.SetTransmitFile(herdrFrame{Path: writeFrameFile(t, w, h, 1), Width: w, Height: h, Format: "rgba"}) {
+		t.Fatalf("first SetTransmitFile refused")
+	}
+	r.Place(Window{Column: 3, Row: 1, Width: 10, Height: 5}, 1, 10, 5, "")
+	first := waitFrame(t, f)
+	if !r.SetTransmitFile(herdrFrame{Path: writeFrameFile(t, w, h, 2), Width: w, Height: h, Format: "rgba"}) {
+		t.Fatalf("second SetTransmitFile refused")
+	}
+	second := waitFrame(t, f)
+	r1, _ := first.header["revision"].(float64)
+	r2, _ := second.header["revision"].(float64)
+	if r2 <= r1 {
+		t.Fatalf("revision did not increase: %v then %v", r1, r2)
+	}
+	if second.body[0] != 2 {
+		t.Fatalf("second body carries fill %d, want 2 (the newest frame)", second.body[0])
+	}
+	pl, _ := second.header["placement"].(map[string]any)
+	if pl["viewport_col"] != float64(3) || pl["viewport_row"] != float64(1) {
+		t.Fatalf("placement = %v, want viewport 3,1", pl)
+	}
+}
+
+func TestKittyHerdrDestroyClearsLayer(t *testing.T) {
+	f := newFakeHerdr(t, true)
+	s, _ := newHerdrSink(herdrEnv(f), unixDial)
+	r := &KittyRelay{id: 11}
+	r.attachHerdr(s)
+	const w, h = 4, 2
+	if !r.SetTransmitFile(herdrFrame{Path: writeFrameFile(t, w, h, 9), Width: w, Height: h, Format: "rgba"}) {
+		t.Fatalf("SetTransmitFile refused")
+	}
+	r.Place(Window{Width: 4, Height: 2}, 1, 4, 2, "")
+	waitFrame(t, f)
+	r.Destroy()
+	select {
+	case p := <-f.clearCh:
+		if p["pane_id"] != "wDE:p7" {
+			t.Fatalf("clear pane_id = %v, want wDE:p7", p["pane_id"])
+		}
+		if layer, _ := p["layer_id"].(string); !strings.HasPrefix(layer, "aerc-relay-") {
+			t.Fatalf("clear layer_id = %v, want the relay's layer", p["layer_id"])
+		}
+	case <-time.After(3 * time.Second):
+		t.Fatalf("Destroy did not send pane.graphics.clear to herdr")
+	}
+	r.Destroy() // idempotent
+}
+
+// Outside herdr nothing changes: no sink, SetTransmitFile declines, and the tty path is intact.
+func TestKittyHerdrOutsideHerdrIsUnchanged(t *testing.T) {
+	s, err := newHerdrSink(func(string) string { return "" }, unixDial)
+	if err != nil || s != nil {
+		t.Fatalf("newHerdrSink without env = (%v, %v), want (nil, nil)", s, err)
+	}
+	r := &KittyRelay{id: 12, rev: 1, sentRev: 0, controls: "f=32,s=4,v=4,t=d", payload: "AAAA"}
+	if r.SetTransmitFile(herdrFrame{Path: "/nonexistent", Width: 1, Height: 1, Format: "rgba"}) {
+		t.Fatalf("SetTransmitFile accepted a frame with no sink attached")
+	}
+	var tty bytes.Buffer
+	r.writePlacement(&tty, 1, "c=1,r=1")
+	if !strings.Contains(tty.String(), "a=T") || !strings.Contains(tty.String(), "C=1") {
+		t.Fatalf("tty path changed without a sink: %q", tty.String())
+	}
+}
+
+// Direct file frames are only ever given to a stream's `primary` layer (herdr keeps named layers
+// on the inline path, capped at 16 MiB), so that is the layer the relay must open.
+func TestKittyHerdrStreamsOnPrimaryLayer(t *testing.T) {
+	f := newFakeHerdrDirect(t, true)
+	s, _ := newHerdrSink(herdrEnv(f), unixDial)
+	r := &KittyRelay{id: 20}
+	r.attachHerdr(s)
+	const w, h = 8, 4
+	if !r.SetTransmitFile(herdrFrame{Path: writeFrameFile(t, w, h, 3), Width: w, Height: h, Format: "rgba"}) {
+		t.Fatalf("SetTransmitFile refused")
+	}
+	r.Place(Window{Column: 0, Row: 1, Width: 8, Height: 4}, 1, 8, 4, "")
+	waitFrame(t, f)
+	f.mu.Lock()
+	layer, _ := f.streams[0]["layer_id"].(string)
+	f.mu.Unlock()
+	if layer != "primary" {
+		t.Fatalf("stream layer_id = %q, want \"primary\" (the only layer herdr passes to the terminal as files)", layer)
+	}
+}
+
+// When herdr advertises a frame directory, the relay hands it a FILE (a same-uid 0600 single-link
+// exact-length copy of the child's frame inside that directory) and no raw body: that is the path
+// herdr's client passes to ghostty as a 182-byte t=f escape instead of 19 MB of pixels.
+func TestKittyHerdrUsesFileFramesWhenAdvertised(t *testing.T) {
+	f := newFakeHerdrDirect(t, true)
+	s, _ := newHerdrSink(herdrEnv(f), unixDial)
+	r := &KittyRelay{id: 21}
+	r.attachHerdr(s)
+	const w, h = 16, 8
+	src := writeFrameFile(t, w, h, 9)
+	if !r.SetTransmitFile(herdrFrame{Path: src, Width: w, Height: h, Format: "rgba"}) {
+		t.Fatalf("SetTransmitFile refused")
+	}
+	r.Place(Window{Column: 2, Row: 3, Width: 16, Height: 8}, 1, 16, 8, "")
+	fr := waitFrame(t, f)
+	if fr.path == "" {
+		t.Fatalf("header carried no file (got data_length=%v): a directory was advertised, so the frame must be a file", fr.header["data_length"])
+	}
+	if _, has := fr.header["data_length"]; has {
+		t.Fatalf("file frame header must not carry data_length (herdr reads the file), got %v", fr.header)
+	}
+	if filepath.Dir(fr.path) != f.fileDir {
+		t.Fatalf("frame file %s is not a direct child of the advertised directory %s", fr.path, f.fileDir)
+	}
+	st, err := os.Lstat(fr.path)
+	if err != nil {
+		t.Fatalf("frame file: %v", err)
+	}
+	if st.Mode().Perm() != 0o600 || !st.Mode().IsRegular() {
+		t.Fatalf("frame file mode %v, want a regular 0600 file", st.Mode())
+	}
+	if sys, ok := st.Sys().(*syscall.Stat_t); ok && sys.Nlink != 1 {
+		t.Fatalf("frame file has %d links, want 1", sys.Nlink)
+	}
+	if st.Size() != int64(w*h*4) {
+		t.Fatalf("frame file is %d bytes, want exactly %d", st.Size(), w*h*4)
+	}
+	want, _ := os.ReadFile(src)
+	if !bytes.Equal(fr.body, want) {
+		t.Fatalf("frame file bytes differ from the child's frame")
+	}
+	pl, _ := fr.header["placement"].(map[string]any)
+	if pl["viewport_col"] != float64(2) || pl["viewport_row"] != float64(3) {
+		t.Fatalf("placement = %v, want viewport 2,3", pl)
+	}
+}
+
+// herdr reads the file when the terminal takes it and only then acks the revision, so a file that
+// has not been acked must never be rewritten under it: the next frame goes to a different file.
+func TestKittyHerdrNeverRewritesAnUnackedFile(t *testing.T) {
+	f := newFakeHerdrDirect(t, false) // manual acks
+	s, _ := newHerdrSink(herdrEnv(f), unixDial)
+	r := &KittyRelay{id: 22}
+	r.attachHerdr(s)
+	const w, h = 8, 4
+	if !r.SetTransmitFile(herdrFrame{Path: writeFrameFile(t, w, h, 1), Width: w, Height: h, Format: "rgba"}) {
+		t.Fatalf("frame 1 refused")
+	}
+	r.Place(Window{Width: 8, Height: 4}, 1, 8, 4, "")
+	first := waitFrame(t, f)
+	if !r.SetTransmitFile(herdrFrame{Path: writeFrameFile(t, w, h, 2), Width: w, Height: h, Format: "rgba"}) {
+		t.Fatalf("frame 2 refused")
+	}
+	second := waitFrame(t, f)
+	if first.path == "" || second.path == "" {
+		t.Fatalf("expected file frames, got paths %q and %q", first.path, second.path)
+	}
+	if first.path == second.path {
+		t.Fatalf("frame 2 rewrote the unacked file of frame 1 (%s)", first.path)
+	}
+	if got, _ := os.ReadFile(first.path); len(got) == 0 || got[0] != 1 {
+		t.Fatalf("frame 1's file changed under herdr before it was acked")
+	}
+	// Once frame 1 is acked its file may be reused; frame 3 must still arrive.
+	rev1, _ := first.header["revision"].(float64)
+	f.ack(t, int(rev1))
+	if !r.SetTransmitFile(herdrFrame{Path: writeFrameFile(t, w, h, 3), Width: w, Height: h, Format: "rgba"}) {
+		t.Fatalf("frame 3 refused")
+	}
+	third := waitFrame(t, f)
+	if len(third.body) == 0 || third.body[0] != 3 {
+		t.Fatalf("frame 3 body carries fill %v, want 3", third.body)
+	}
+}
+
+// A pane herdr reports as not visible gets no sink: the tty path is the safe default.
+func TestKittyHerdrInvisiblePaneGetsNoSink(t *testing.T) {
+	f := newFakeHerdr(t, false)
+	s, err := newHerdrSink(herdrEnv(f), unixDial)
+	if s != nil {
+		t.Fatalf("got a sink for a pane herdr reports as not visible (err=%v)", err)
+	}
+}
diff --git c/relay_rev_test.go w/relay_rev_test.go
new file mode 100644
index 0000000..9af2d05
--- /dev/null
+++ w/relay_rev_test.go
@@ -0,0 +1,61 @@
+package vaxis
+
+import (
+	"bytes"
+	"strings"
+	"testing"
+)
+
+// A relayed frame replaces its predecessor in place: the bytes change under the
+// same host image id at the same cell, so the render must emit a second a=T with
+// no delete in between (a delete would blank the pane for a frame on every frame
+// the child sends). Placing again without new bytes must write nothing at all.
+func TestKittyRelayRev(t *testing.T) {
+	var out bytes.Buffer
+	vx := newWriterTestVaxis(&out)
+	win := vx.Window()
+
+	r := vx.NewKittyRelay()
+
+	r.SetTransmit("f=32,s=8,v=8,t=d", "AAAA")
+	vx.graphicsNext = nil
+	r.Place(win, 1, 2, 1, "")
+	vx.render()
+	if _, err := vx.tw.Flush(); err != nil {
+		t.Fatal(err)
+	}
+	first := out.String()
+	if !strings.Contains(first, "a=T") {
+		t.Fatalf("first frame = %q, want an a=T transmit", first)
+	}
+
+	out.Reset()
+	r.SetTransmit("f=32,s=8,v=8,t=d", "BBBB")
+	vx.graphicsNext = nil
+	r.Place(win, 1, 2, 1, "")
+	vx.render()
+	if _, err := vx.tw.Flush(); err != nil {
+		t.Fatal(err)
+	}
+	second := out.String()
+	if !strings.Contains(second, "a=T") {
+		t.Fatalf("second frame = %q, want a second a=T transmit", second)
+	}
+	if !strings.Contains(second, "BBBB") {
+		t.Fatalf("second frame = %q, want the new payload", second)
+	}
+	if strings.Contains(second, "a=d,d=i") {
+		t.Fatalf("second frame = %q, want no delete before the replacement", second)
+	}
+
+	out.Reset()
+	vx.graphicsNext = nil
+	r.Place(win, 1, 2, 1, "")
+	vx.render()
+	if _, err := vx.tw.Flush(); err != nil {
+		t.Fatal(err)
+	}
+	if third := out.String(); third != "" {
+		t.Fatalf("re-place at the same rev wrote %q, want nothing", third)
+	}
+}
