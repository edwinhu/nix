#!/usr/bin/env bash
# hmail — himalaya, with the account's real HTML signature on everything you compose.
#
# WHY THIS EXISTS
#
# himalaya's `signature` config key is plain text only, and it actively escapes
# MML inside a signature (`<#part …>` becomes `<#!part …>`), so the UVA HTML
# signature — the one with the orange Web | SSRN | Bio links — cannot be
# expressed there. MML in a message BODY is not escaped, so hmail builds the
# body itself. owa-bridge posts the exact bytes himalaya composed to Outlook's
# /sendmail, so what this builds is what the recipient sees.
#
# Compose verbs are wrapped. EVERYTHING ELSE PASSES THROUGH to himalaya
# untouched, so `hmail envelope list -a work -s 10` works and there is no second
# copy of himalaya's interface to maintain:
#
#   hmail write   -a work -t "x@y.edu" -s "Subject" -b "Body."
#   hmail reply     -a work <id> -b "Thanks."          # threaded, keeps In-Reply-To
#   hmail reply-all -a work <id> -b "Thanks."
#   hmail forward -a work <id> -t "z@q.com" -b "FYI."
#   hmail envelope list -a work -s 10                  # -> himalaya, verbatim
#
# A bare `hmail -a … -t … -s … -b …` (no verb) is treated as `write`.
#
# DRAFT BY DEFAULT. --send is required to send, and reports what it did.
#
# -b takes plain text: blank lines become paragraphs, and it is HTML-escaped.
# -B FILE uses the file contents verbatim (already HTML). --html does the same
# for an inline -b string.

set -euo pipefail

SIGDIR="${HIMALAYA_SIG_DIR:-$HOME/.local/share/himalaya/signatures}"

die() { printf 'hmail: %s\n' "$1" >&2; exit 1; }

# --- passthrough -----------------------------------------------------------
# Anything that is not a compose verb is himalaya's job. Decided before argument
# parsing so passthrough flags are never misread as hmail's.
VERB="${1:-}"
case "$VERB" in
  write|reply|reply-all|forward) shift ;;
  -h|--help)                     sed -n '2,30p' "$0" | sed 's/^# \?//'; exit 0 ;;
  -*|"")                         VERB="write" ;;          # bare flags => write
  *)                             exec himalaya "$@" ;;    # envelope, flag, move…
esac

ACCOUNT="" TO="" CC="" BCC="" SUBJECT="" BODY="" BODYFILE="" FOLDER=""
SEND=0 RAWHTML=0 REPLY_ALL=0 MSGID=""
ATTACHMENTS=()

[[ "$VERB" == "reply-all" ]] && { VERB="reply"; REPLY_ALL=1; }

while [[ $# -gt 0 ]]; do
  case "$1" in
    -a|--account)   ACCOUNT="$2"; shift 2 ;;
    -t|--to)        TO="$2"; shift 2 ;;
    -c|--cc)        CC="$2"; shift 2 ;;
    --bcc)          BCC="$2"; shift 2 ;;
    -s|--subject)   SUBJECT="$2"; shift 2 ;;
    -b|--body)      BODY="$2"; shift 2 ;;
    -B|--body-file) BODYFILE="$2"; shift 2 ;;
    -f|--folder)    FOLDER="$2"; shift 2 ;;
    -A|--all)       REPLY_ALL=1; shift ;;
    --html)         RAWHTML=1; shift ;;
    --attach)       ATTACHMENTS+=("$2"); shift 2 ;;
    --send)         SEND=1; shift ;;
    -h|--help)      sed -n '2,30p' "$0" | sed 's/^# \?//'; exit 0 ;;
    -*)             die "unknown flag: $1" ;;
    *)              MSGID="$1"; shift ;;
  esac
done

[[ -n "$ACCOUNT" ]] || die "missing -a/--account (work|personal)"
[[ -n "$BODY" || -n "$BODYFILE" ]] || die "missing -b/--body or -B/--body-file"

SIG="$SIGDIR/$ACCOUNT.html"
[[ -f "$SIG" ]] || die "no signature at $SIG — add one, or set HIMALAYA_SIG_DIR"

for f in ${ATTACHMENTS+"${ATTACHMENTS[@]}"}; do
  [[ -f "$f" ]] || die "attachment not found: $f"
done

case "$VERB" in
  write)
    [[ -n "$TO" ]]      || die "write: missing -t/--to (owa-bridge refuses a message with no recipient header)"
    [[ -n "$SUBJECT" ]] || die "write: missing -s/--subject"
    ;;
  reply)
    [[ -n "$MSGID" ]] || die "reply: missing message id (e.g. hmail reply -a work 1234 -b '…')"
    ;;
  forward)
    [[ -n "$MSGID" ]] || die "forward: missing message id"
    [[ -n "$TO" ]]    || die "forward: missing -t/--to"
    ;;
esac

render_body() {
  if [[ -n "$BODYFILE" ]]; then
    cat "$BODYFILE"
  elif [[ $RAWHTML -eq 1 ]]; then
    printf '%s\n' "$BODY"
  else
    printf '%s\n' "$BODY" | python3 -c '
import html, sys
text = sys.stdin.read().strip("\n")
for para in text.split("\n\n"):
    para = para.strip("\n")
    if para:
        print("<p>" + html.escape(para).replace("\n", "<br>") + "</p>")
'
  fi
}

TMP="$(mktemp -t hmail.XXXXXX)"
ORIG="$TMP.orig"
trap 'rm -f "$TMP" "$ORIG"' EXIT

if [[ "$VERB" == "write" ]]; then
  {
    printf 'To: %s\n' "$TO"
    [[ -n "$CC"  ]] && printf 'Cc: %s\n' "$CC"
    [[ -n "$BCC" ]] && printf 'Bcc: %s\n' "$BCC"
    printf 'Subject: %s\n\n' "$SUBJECT"
    printf '<#part type=text/html>\n'
    render_body
    printf '<div><br></div>\n'
    cat "$SIG"
    printf '<#/part>\n'
  } > "$TMP"
else
  # Let himalaya compute the hard parts — In-Reply-To, the To/Cc set, the "Re:"
  # or "Fwd:" subject and the quoted original — then keep its headers and swap
  # the plain body for an HTML part. Reimplementing threading by hand is how you
  # get replies that start a new conversation in the recipient's client.
  HIM=(himalaya template "$VERB" -a "$ACCOUNT")
  [[ -n "$FOLDER" ]] && HIM+=(-f "$FOLDER")
  [[ "$VERB" == "reply" && $REPLY_ALL -eq 1 ]] && HIM+=(-A)
  HIM+=("$MSGID")

  "${HIM[@]}" > "$ORIG" 2>/dev/null \
    || die "$VERB: himalaya could not build a template for message $MSGID"

  BODY_HTML="$(render_body)" \
  SIG_HTML="$(cat "$SIG")" \
  EXTRA_TO="$TO" EXTRA_CC="$CC" EXTRA_BCC="$BCC" SUBJ_OVERRIDE="$SUBJECT" \
  python3 - "$ORIG" > "$TMP" <<'PY'
import html, os, re, sys

raw = open(sys.argv[1]).read()
head, _, body = raw.partition("\n\n")
headers = [ln for ln in head.split("\n") if ln.strip()]

def set_header(name, value):
    """Replace or append a header, leaving himalaya's threading headers alone."""
    if not value:
        return
    for i, ln in enumerate(headers):
        if ln.lower().startswith(name.lower() + ":"):
            headers[i] = f"{name}: {value}"
            return
    headers.append(f"{name}: {value}")

# forward has no recipient until we give it one; -t/-c also override on reply.
set_header("To", os.environ.get("EXTRA_TO", ""))
set_header("Cc", os.environ.get("EXTRA_CC", ""))
set_header("Bcc", os.environ.get("EXTRA_BCC", ""))
set_header("Subject", os.environ.get("SUBJ_OVERRIDE", ""))

# himalaya inserts the plain-text config signature into the body it builds.
# Drop it: the HTML signature below replaces it, and sending both is the exact
# failure this wrapper exists to avoid. Guard the "Best," heuristic so it never
# eats the quoted original (which is what a stray "Best," inside a quote would).
body = re.sub(r"\n-- \n.*\Z", "\n", body, flags=re.S)
m = re.search(r"\nBest,\s*\n", body)
if m and not body[: m.start()].rstrip().endswith("wrote:"):
    if not any(ln.startswith(">") for ln in body[: m.start()].split("\n")[-3:]):
        body = body[: m.start()]

# The quoted original comes back as an attribution line plus "> " prefixes.
# Render it as a real blockquote so the reply reads as a reply in an HTML client.
quoted, attribution = [], ""
for line in body.split("\n"):
    if line.startswith(">"):
        quoted.append(html.escape(line.lstrip(">").lstrip()))
    elif re.match(r"^On .+wrote:\s*$", line.strip()) and not attribution:
        attribution = html.escape(line.strip())

print("\n".join(headers))
print()
print("<#part type=text/html>")
print(os.environ["BODY_HTML"])
print("<div><br></div>")
print(os.environ["SIG_HTML"])
if quoted:
    print("<div><br></div>")
    if attribution:
        print(f"<div>{attribution}</div>")
    print('<blockquote style="margin:0 0 0 .8ex;border-left:2px solid #ccc;padding-left:1ex">')
    print("<br>".join(quoted))
    print("</blockquote>")
print("<#/part>")
PY
fi

for f in ${ATTACHMENTS+"${ATTACHMENTS[@]}"}; do
  printf '<#part filename=%s disposition=attachment>\n' "$f" >> "$TMP"
done

if [[ $SEND -eq 1 ]]; then
  himalaya template send -a "$ACCOUNT" < "$TMP"
  printf 'hmail: SENT (%s) via %s\n' "$VERB" "$ACCOUNT" >&2
else
  himalaya template save -a "$ACCOUNT" -f drafts < "$TMP"
  printf 'hmail: saved as a DRAFT (%s). Add --send to send.\n' "$VERB" >&2
fi
